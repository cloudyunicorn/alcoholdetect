---
import Layout from '../layouts/Layout.astro';
import emergencyNumbers from '../data/emergencyNumbers.json';
---


<Layout
  title="BAC Calculator | Online Alcohol Detect"
  description="Estimate Blood Alcohol Content (BAC) using Online Alcohol Detect. Track sobriety time and calculate alcohol levels by weight, gender, and country limits."
>
  <!-- Hero Section with Mesh Gradient -->
  <section class="relative overflow-hidden bg-canvas py-16 md:py-24 border-b border-hairline" id="hero">
    <!-- Mesh Gradient Backdrop -->
    <div class="absolute inset-0 pointer-events-none opacity-40 select-none overflow-hidden" aria-hidden="true">
      <div class="absolute top-[-20%] left-[-10%] w-[60%] h-[70%] rounded-full bg-gradient-to-br from-gradient-develop-start to-gradient-develop-end blur-[120px] transform-gpu"></div>
      <div class="absolute top-[-30%] right-[-10%] w-[50%] h-[80%] rounded-full bg-gradient-to-bl from-gradient-preview-start to-gradient-preview-end blur-[140px] transform-gpu"></div>
      <div class="absolute bottom-[-10%] left-[20%] w-[45%] h-[60%] rounded-full bg-gradient-to-tr from-gradient-ship-start to-gradient-ship-end blur-[120px] transform-gpu"></div>
      <div class="absolute top-[20%] left-[40%] w-[35%] h-[50%] rounded-full bg-cyan-soft/30 blur-[100px] transform-gpu"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 md:px-6 relative z-10 text-center flex flex-col items-center">
      <!-- Section Eyebrow -->
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-pill bg-canvas-soft border border-hairline text-xs font-mono text-body mb-6 shadow-vercel-1">
        <span class="w-1.5 h-1.5 rounded-full bg-link animate-pulse"></span>
        CLINICAL-GRADE&nbsp;BAC&nbsp;CALCULATOR
      </span>
      
      <!-- Headline -->
      <h1 class="font-sans text-4xl md:text-5xl font-semibold tracking-[-2.4px] leading-[1.05] text-primary max-w-3xl mb-6 text-balance">
        Know your limit. Drive safe.
      </h1>
      
      <!-- Description -->
      <p class="font-sans text-base text-body max-w-2xl mb-8 leading-relaxed text-pretty">
        <strong>Online Alcohol Detect</strong> is an advanced Blood Alcohol Concentration (BAC) estimator utilizing Watson’s Total Body Water equations. Select your country’s legal limit, build your drink timeline, and visualize your sobriety countdown.
      </p>
      
      <!-- CTA Button Row -->
      <div class="flex flex-col sm:flex-row gap-4 items-center">
        <a href="#calculator" class="inline-flex items-center justify-center bg-primary hover:bg-primary/95 text-canvas-soft text-sm font-semibold tracking-wide h-11 px-8 rounded-pill transition-vercel shadow-vercel-3 focus:ring-2 focus:ring-link focus:outline-none" id="hero-primary-cta">
          Start Calculating
        </a>
        <a href="#science" class="inline-flex items-center justify-center bg-canvas hover:bg-canvas-soft border border-hairline text-ink text-sm font-semibold tracking-wide h-11 px-8 rounded-pill transition-vercel shadow-vercel-2 focus:ring-2 focus:ring-link focus:outline-none" id="hero-secondary-cta">
          Explore the Science
        </a>
      </div>
    </div>
  </section>

  <!-- Main Calculator & Dashboard Section -->
  <section class="py-12 md:py-20 bg-canvas-soft scroll-mt-20" id="calculator">
    <div class="max-w-7xl mx-auto px-4 md:px-6">
      
      <!-- Section Header -->
      <div class="mb-8 text-center md:text-left flex flex-col sm:flex-row items-center sm:items-end justify-between gap-4 border-b border-hairline pb-6">
        <div>
          <h2 class="font-sans text-2xl md:text-3xl font-semibold tracking-[-1.28px] text-primary text-pretty">
            BAC Estimator Dashboard.
          </h2>
          <p class="text-body text-xs md:text-sm mt-1">
            Configure your biology, log your drink consumption timeline, and get real-time safety analytics.
          </p>
        </div>
        <button class="text-xs font-mono font-medium border border-error hover:bg-error-soft text-error hover:text-error-deep px-4 py-2 rounded-sm bg-canvas transition-vercel focus:ring-2 focus:ring-error focus:outline-none" id="btn-clear-timeline" aria-label="Clear Timeline">
          Clear Drink Log
        </button>
      </div>

      <!-- Step-by-Step Stepper & Mobile Tab Selector -->
      <div class="max-w-xl mx-auto mb-10">
        <!-- Visual Stepper Indicator -->
        <div class="flex items-center justify-between px-4" role="tablist" aria-label="Calculator Progress Stepper">
          <!-- Step 1 Tab -->
          <button type="button" class="flex flex-col items-center gap-2 group focus:outline-none" id="tab-profile" role="tab" aria-selected="true" aria-controls="col-profile">
            <span class="w-7 h-7 rounded-full bg-primary text-canvas-soft text-xs font-semibold flex items-center justify-center transition-vercel group-focus-visible:ring-2 group-focus-visible:ring-link" id="step-num-1">1</span>
            <span class="text-xs font-semibold text-primary" id="step-txt-1">Profile</span>
          </button>
          
          <!-- Line 1-2 -->
          <div class="flex-grow h-px bg-hairline-strong mx-2" id="step-line-1"></div>
          
          <!-- Step 2 Tab -->
          <button type="button" class="flex flex-col items-center gap-2 group focus:outline-none" id="tab-log" role="tab" aria-selected="false" aria-controls="col-log">
            <span class="w-7 h-7 rounded-full bg-canvas border border-hairline text-body text-xs font-semibold flex items-center justify-center transition-vercel group-focus-visible:ring-2 group-focus-visible:ring-link" id="step-num-2">2</span>
            <span class="text-xs font-medium text-body" id="step-txt-2">Log Drinks</span>
          </button>
          
          <!-- Line 2-3 -->
          <div class="flex-grow h-px bg-hairline mx-2" id="step-line-2"></div>
          
          <!-- Step 3 Tab -->
          <button type="button" class="flex flex-col items-center gap-2 group focus:outline-none" id="tab-results" role="tab" aria-selected="false" aria-controls="col-results">
            <span class="w-7 h-7 rounded-full bg-canvas border border-hairline text-body text-xs font-semibold flex items-center justify-center transition-vercel group-focus-visible:ring-2 group-focus-visible:ring-link" id="step-num-3">3</span>
            <span class="text-xs font-medium text-body" id="step-txt-3">Analytics</span>
          </button>
        </div>
      </div>

      <!-- Main Calculator Container (Wizard Steps) -->
      <div class="w-full relative min-h-[500px]">
        
        <!-- Lane 1: Biological Profile - Active by default -->
        <div id="col-profile" class="w-full max-w-xl mx-auto flex flex-col gap-6">
          <div class="bg-canvas border border-hairline rounded-lg p-6 md:p-8 shadow-vercel-3 flex flex-col justify-between h-full min-h-[480px]">
            <div>
              <h3 class="font-sans text-lg font-semibold tracking-[-0.6px] text-primary mb-6 flex items-center gap-2">
                <svg class="h-5 w-5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                Step 1: Biological Profile
              </h3>
              
              <div class="space-y-5">
                <!-- Gender Toggle -->
                <div>
                  <label class="block font-mono text-[11px] font-semibold text-mute uppercase tracking-wider mb-2">Biological Gender</label>
                  <div class="grid grid-cols-3 gap-2 bg-canvas-soft-2 p-1 rounded-sm border border-hairline" role="group" aria-label="Gender Select">
                    <button type="button" class="py-1.5 text-xs font-medium rounded-xs text-primary bg-canvas shadow-vercel-2 border border-hairline/20 transition-vercel focus:outline-none focus-visible:ring-0 focus-visible:outline-none" id="btn-gender-male" data-gender="male">Male</button>
                    <button type="button" class="py-1.5 text-xs font-medium rounded-xs text-body hover:text-ink border border-transparent transition-vercel focus:outline-none focus-visible:ring-0 focus-visible:outline-none" id="btn-gender-female" data-gender="female">Female</button>
                    <button type="button" class="py-1.5 text-xs font-medium rounded-xs text-body hover:text-ink border border-transparent transition-vercel focus:outline-none focus-visible:ring-0 focus-visible:outline-none" id="btn-gender-other" data-gender="other" title="Uses average biological metrics for inclusive calculation.">Others</button>
                  </div>
                </div>

                <!-- Age Input -->
                <div>
                  <div class="flex justify-between items-center mb-2">
                    <label for="profile-age" class="font-mono text-[11px] font-semibold text-mute uppercase tracking-wider">Age</label>
                    <span class="text-xs font-mono font-medium text-primary"><span id="lbl-age-val">30</span> yrs</span>
                  </div>
                  <div class="flex gap-4 items-center">
                    <input type="range" id="profile-age-slider" min="16" max="90" value="30" class="w-full accent-primary h-1 bg-canvas-soft-2 rounded-lg cursor-pointer" aria-label="Age slider" />
                    <input type="number" id="profile-age" min="16" max="90" value="30" class="w-16 h-8 text-center text-sm border border-hairline rounded-sm bg-canvas font-mono focus:ring-2 focus:ring-link focus:outline-none" aria-label="Age value in years" />
                  </div>
                </div>

                <!-- Weight Input -->
                <div>
                  <div class="flex justify-between items-center mb-2">
                    <label for="profile-weight" class="font-mono text-[11px] font-semibold text-mute uppercase tracking-wider">Body Weight</label>
                    <div class="flex rounded-sm bg-canvas-soft-2 p-0.5 border border-hairline" role="group" aria-label="Weight Unit Switch">
                      <button type="button" class="px-2 py-0.5 text-[10px] font-semibold font-mono rounded-xs text-primary bg-canvas shadow-vercel-1 border border-hairline/10 focus:outline-none" id="btn-weight-kg" data-unit="kg">KG</button>
                      <button type="button" class="px-2 py-0.5 text-[10px] font-semibold font-mono rounded-xs text-body hover:text-ink focus:outline-none" id="btn-weight-lbs" data-unit="lbs">LBS</button>
                    </div>
                  </div>
                  <div class="relative">
                    <input type="number" id="profile-weight" min="30" max="250" value="75" class="w-full h-10 px-3 border border-hairline rounded-sm bg-canvas text-sm font-mono focus:ring-2 focus:ring-link focus:outline-none" aria-label="Body weight value" />
                    <span class="absolute right-3 top-2.5 text-xs text-mute font-mono" id="profile-weight-unit">kg</span>
                  </div>
                </div>

                <!-- Height Input -->
                <div>
                  <div class="flex justify-between items-center mb-2">
                    <label for="profile-height" class="font-mono text-[11px] font-semibold text-mute uppercase tracking-wider">Height</label>
                    <div class="flex rounded-sm bg-canvas-soft-2 p-0.5 border border-hairline" role="group" aria-label="Height Unit Switch">
                      <button type="button" class="px-2 py-0.5 text-[10px] font-semibold font-mono rounded-xs text-primary bg-canvas shadow-vercel-1 border border-hairline/10 focus:outline-none" id="btn-height-cm" data-unit="cm">CM</button>
                      <button type="button" class="px-2 py-0.5 text-[10px] font-semibold font-mono rounded-xs text-body hover:text-ink focus:outline-none" id="btn-height-in" data-unit="in">IN</button>
                    </div>
                  </div>
                  <div class="relative">
                    <input type="number" id="profile-height" min="100" max="250" value="175" class="w-full h-10 px-3 border border-hairline rounded-sm bg-canvas text-sm font-mono focus:ring-2 focus:ring-link focus:outline-none" aria-label="Body height value" />
                    <span class="absolute right-3 top-2.5 text-xs text-mute font-mono" id="profile-height-unit">cm</span>
                  </div>
                </div>

                <!-- Country Select / Driving Limit -->
                <div>
                  <label for="profile-country" class="block font-mono text-[11px] font-semibold text-mute uppercase tracking-wider mb-2">Country Driving Limit</label>
                  <select id="profile-country" class="w-full h-10 px-3 border border-hairline rounded-sm bg-canvas text-sm focus:ring-2 focus:ring-link focus:outline-none appearance-none" style="background-image: url('data:image/svg+xml;charset=utf-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 20 20%22 fill=%22none%22%3E%3Cpath d=%22M7 9l3 3 3-3%22 stroke=%22%23666%22 stroke-width=%221.5%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3C/svg%3E'); background-position: right 8px center; background-repeat: no-repeat; background-size: 20px;" aria-label="Select Country for Driving Limit">
                    <!-- JS to populate -->
                  </select>
                  
                  <!-- Country Limit Warning Box -->
                  <div id="out-country-warning-box" class="mt-3 p-3 rounded-sm bg-canvas-soft border border-hairline text-xs text-body">
                    <p id="out-country-warning-text">United States legal limit is <span class="font-mono font-semibold">0.08%</span> BAC. Strict limits for commercial drivers (0.04%) and zero-tolerance under 21.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Profile next CTA button -->
            <button type="button" class="w-full h-10 mt-6 bg-primary hover:bg-primary/95 text-canvas-soft font-semibold text-sm rounded-sm transition-vercel shadow-vercel-2 focus:ring-2 focus:ring-link focus:outline-none" id="btn-to-step-2">
              Next: Log Drinks
            </button>
          </div>
        </div>

        <!-- Lane 2: Logging & Timeline -->
        <div id="col-log" class="w-full max-w-5xl mx-auto flex flex-col gap-6 relative min-h-[500px] hidden">
          
          <!-- Step 2 Lock Overlay (Visible until Step 1 is finished) -->
          <div id="log-lock-overlay" class="absolute inset-0 z-20 bg-canvas/90 backdrop-blur-md border border-hairline rounded-lg p-6 md:p-8 flex flex-col items-center justify-center text-center shadow-vercel-3 transition-vercel">
            <svg class="h-10 w-10 text-mute mb-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <h3 class="font-sans text-lg font-semibold tracking-[-0.6px] text-primary">Step 2: Log Drinks Locked</h3>
            <p class="text-xs text-body mt-2 max-w-[240px] leading-relaxed">
              Complete your biological profile in Step 1 first. Then click <span class="font-semibold text-primary">"Next: Log Drinks"</span> to unlock this section.
            </p>
          </div>

          <!-- Main Log Content -->
          <div id="log-dashboard-content" class="grid grid-cols-1 md:grid-cols-2 gap-6 opacity-30 pointer-events-none transition-vercel select-none">
            <!-- Logger Card -->
            <div class="bg-canvas border border-hairline rounded-lg p-6 md:p-8 shadow-vercel-3 flex flex-col flex-grow">
            <h3 class="font-sans text-lg font-semibold tracking-[-0.6px] text-primary mb-6 flex items-center gap-2">
              <svg class="h-5 w-5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Step 2: Add Drinks
            </h3>

            <!-- Custom Form Inputs -->
            <div class="space-y-4 border-t border-hairline pt-5">
              <!-- Hidden select dropdown for backward compatibility/JS logic -->
              <div class="hidden">
                <label for="drink-select">Select Drink</label>
                <select id="drink-select">
                  <option value="beer-reg" data-name="Regular Beer" data-vol="355" data-abv="5.0">🍺 Regular Beer</option>
                  <option value="beer-light" data-name="Light Beer" data-vol="355" data-abv="4.2">🍺 Light Beer</option>
                  <option value="beer-craft" data-name="Craft IPA" data-vol="355" data-abv="7.0">🍻 Craft IPA</option>
                  <option value="wine-red" data-name="Red Wine" data-vol="148" data-abv="13.5">🍷 Red Wine</option>
                  <option value="wine-white" data-name="White Wine" data-vol="148" data-abv="12.0">🥂 White Wine</option>
                  <option value="champagne" data-name="Champagne" data-vol="120" data-abv="12.0">🍾 Champagne</option>
                  <option value="shot-whiskey" data-name="Whiskey Shot" data-vol="44" data-abv="40.0">🥃 Whiskey Shot</option>
                  <option value="shot-vodka" data-name="Vodka Shot" data-vol="44" data-abv="40.0">🥃 Vodka Shot</option>
                  <option value="shot-tequila" data-name="Tequila Shot" data-vol="44" data-abv="40.0">🥃 Tequila Shot</option>
                  <option value="cider" data-name="Apple Cider" data-vol="473" data-abv="5.0">🍏 Cider</option>
                  <option value="cocktail-gt" data-name="Gin & Tonic" data-vol="200" data-abv="6.0">🍸 Gin & Tonic</option>
                  <option value="cocktail-margarita" data-name="Margarita" data-vol="120" data-abv="15.0">🍹 Margarita</option>
                  <option value="cocktail-martini" data-name="Martini" data-vol="90" data-abv="30.0">🍸 Martini</option>
                  <option value="cocktail-rumcoke" data-name="Rum & Coke" data-vol="200" data-abv="8.0">🥃 Rum & Coke</option>
                  <option value="custom" data-name="Custom Drink" data-vol="355" data-abv="5.0">⚙️ Custom Drink...</option>
                </select>
              </div>

              <!-- Visual Preset Categories -->
              <div>
                <label class="block font-mono text-[11px] font-semibold text-mute uppercase tracking-wider mb-2">Select Category</label>
                <div class="grid grid-cols-5 gap-1.5" role="group" aria-label="Drink Category Presets">
                  <button type="button" data-preset-cat="beer" class="py-2.5 px-1 flex flex-col items-center justify-center gap-1.5 border border-transparent bg-primary text-canvas-soft shadow-vercel-2 rounded-sm transition-vercel focus:outline-none cursor-pointer" aria-label="Select Beer Category">
                    <span class="text-xl">🍺</span>
                    <span class="text-[10px] font-semibold">Beer</span>
                  </button>
                  <button type="button" data-preset-cat="wine" class="py-2.5 px-1 flex flex-col items-center justify-center gap-1.5 border border-hairline bg-canvas text-body hover:text-ink rounded-sm transition-vercel focus:outline-none cursor-pointer" aria-label="Select Wine Category">
                    <span class="text-xl">🍷</span>
                    <span class="text-[10px] font-semibold">Wine</span>
                  </button>
                  <button type="button" data-preset-cat="shot" class="py-2.5 px-1 flex flex-col items-center justify-center gap-1.5 border border-hairline bg-canvas text-body hover:text-ink rounded-sm transition-vercel focus:outline-none cursor-pointer" aria-label="Select Liquor/Shot Category">
                    <span class="text-xl">🥃</span>
                    <span class="text-[10px] font-semibold">Liquor/Shot</span>
                  </button>
                  <button type="button" data-preset-cat="cocktail" class="py-2.5 px-1 flex flex-col items-center justify-center gap-1.5 border border-hairline bg-canvas text-body hover:text-ink rounded-sm transition-vercel focus:outline-none cursor-pointer" aria-label="Select Cocktail Category">
                    <span class="text-xl">🍸</span>
                    <span class="text-[10px] font-semibold">Cocktail</span>
                  </button>
                  <button type="button" data-preset-cat="custom" class="py-2.5 px-1 flex flex-col items-center justify-center gap-1.5 border border-hairline bg-canvas text-body hover:text-ink rounded-sm transition-vercel focus:outline-none cursor-pointer" aria-label="Select Custom Category">
                    <span class="text-xl">⚙️</span>
                    <span class="text-[10px] font-semibold">Custom</span>
                  </button>
                </div>
              </div>

              <!-- Contextual Presets (Volume & ABV) -->
              <div id="sub-presets-volume" class="transition-vercel">
                <label class="block font-mono text-[11px] font-semibold text-mute uppercase tracking-wider mb-1.5">Quick Size</label>
                <div id="volume-pills-list" class="flex flex-wrap gap-1.5">
                  <!-- JS Injected Volume Pills -->
                </div>
              </div>

              <div id="sub-presets-abv" class="transition-vercel">
                <label class="block font-mono text-[11px] font-semibold text-mute uppercase tracking-wider mb-1.5">Quick Strength</label>
                <div id="abv-pills-list" class="flex flex-wrap gap-1.5">
                  <!-- JS Injected ABV Pills -->
                </div>
              </div>

              <!-- Advanced Fine-Tuning Block -->
              <div class="border-t border-hairline/60 pt-4 mt-3">
                <div class="font-mono text-[10px] font-bold text-mute uppercase tracking-wider mb-2 flex items-center justify-between cursor-pointer select-none" id="advanced-toggle" role="button" aria-expanded="true" aria-controls="advanced-form-fields">
                  <span>Fine-tune Drink Details</span>
                  <svg id="advanced-toggle-icon" class="h-3 w-3 transform rotate-180 transition-transform duration-200 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
                
                <div id="advanced-form-fields" class="space-y-4 transition-all duration-300">
                  <!-- Custom Label input (hidden by default unless category is custom) -->
                  <div id="custom-drink-label-container" class="hidden">
                    <label for="drink-name" class="block font-mono text-[11px] font-semibold text-mute uppercase tracking-wider mb-1.5">Custom Drink Name</label>
                    <input type="text" id="drink-name" value="Regular Beer" class="w-full h-10 px-3 border border-hairline rounded-sm bg-canvas text-sm focus:ring-2 focus:ring-link focus:outline-none" placeholder="Enter custom name…" autocomplete="off" />
                  </div>

                  <!-- Volume Input -->
                  <div>
                    <div class="flex justify-between items-center mb-1.5">
                      <label for="drink-volume" class="font-mono text-[11px] font-semibold text-mute uppercase tracking-wider">Volume</label>
                      <div class="flex rounded-sm bg-canvas-soft-2 p-0.5 border border-hairline" role="group" aria-label="Volume Unit Switch">
                        <button type="button" class="px-2 py-0.5 text-[10px] font-semibold font-mono rounded-xs text-primary bg-canvas shadow-vercel-1 border border-hairline/10 focus:outline-none" id="btn-volume-ml" data-unit="ml">ML</button>
                        <button type="button" class="px-2 py-0.5 text-[10px] font-semibold font-mono rounded-xs text-body hover:text-ink focus:outline-none" id="btn-volume-oz" data-unit="oz">OZ</button>
                      </div>
                    </div>
                    <div class="relative">
                      <input type="number" id="drink-volume" min="5" max="3000" value="355" class="w-full h-10 px-3 border border-hairline rounded-sm bg-canvas text-sm font-mono focus:ring-2 focus:ring-link focus:outline-none" aria-label="Drink volume" />
                      <span class="absolute right-3 top-2.5 text-xs text-mute font-mono" id="drink-volume-unit">ml</span>
                    </div>
                  </div>

                  <!-- ABV Input -->
                  <div>
                    <div class="flex justify-between items-center mb-1.5">
                      <label for="drink-abv" class="font-mono text-[11px] font-semibold text-mute uppercase tracking-wider">ABV (%)</label>
                      <span class="text-xs font-mono font-medium text-primary"><span id="lbl-abv-val">5.0</span>%</span>
                    </div>
                    <div class="flex gap-4 items-center">
                      <input type="range" id="drink-abv-slider" min="0.5" max="75.0" step="0.5" value="5.0" class="w-full accent-primary h-1 bg-canvas-soft-2 rounded-lg cursor-pointer" aria-label="ABV slider" />
                      <input type="number" id="drink-abv" min="0.5" max="75.0" step="0.1" value="5.0" class="w-16 h-8 text-center text-sm border border-hairline rounded-sm bg-canvas font-mono focus:ring-2 focus:ring-link focus:outline-none" aria-label="ABV value in percent" />
                    </div>
                  </div>
                </div>

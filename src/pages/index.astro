    <!-- Toast notifications injected dynamically here -->
  </div>

  <!-- Main Calculator Client Side Javascript -->
  <script>
    import { animate } from 'motion';

    // ─── Constants & Configurations ───
    const COUNTRIES = [
      { code: 'US', name: 'United States', limit: 0.08, note: 'Strict limits for commercial drivers (0.04%) and zero-tolerance under 21.' },
      { code: 'GB', name: 'United Kingdom', limit: 0.08, note: 'Scotland has a lower limit of 0.05%.' },
      { code: 'SC', name: 'Scotland', limit: 0.05, note: 'Lower limit than England/Wales/N. Ireland.' },
      { code: 'CA', name: 'Canada', limit: 0.08, note: 'Warnings and administrative suspensions start at 0.05% in most provinces.' },
      { code: 'AU', name: 'Australia', limit: 0.05, note: '0.00% for learner and provisional drivers.' },
      { code: 'DE', name: 'Germany', limit: 0.05, note: '0.00% for drivers under 21 or in their first two licensing years.' },
      { code: 'FR', name: 'France', limit: 0.05, note: 'Stricter limit of 0.02% applies to novice drivers and bus operators.' },
      { code: 'IN', name: 'India', limit: 0.03, note: 'Equivalent to 30 mg alcohol per 100 ml blood. Zero tolerance in several states.' },
      { code: 'JP', name: 'Japan', limit: 0.03, note: 'Extremely strict penalties. Virtually zero tolerance in practical enforcement.' },
      { code: 'SE', name: 'Sweden', limit: 0.02, note: 'Zero-tolerance baseline.' },
      { code: 'NO', name: 'Norway', limit: 0.02, note: 'Strict limits. Income-based fines for violations.' },
      { code: 'ES', name: 'Spain', limit: 0.05, note: 'Stricter limit of 0.03% applies to novice and professional drivers.' },
      { code: 'BR', name: 'Brazil', limit: 0.00, note: 'Lei Seca (Dry Law) enforces absolute zero-tolerance.' },
      { code: 'CN', name: 'China', limit: 0.02, note: 'DUI baseline is 0.02%. Criminal DWI starts at 0.08%.' },
      { code: 'RU', name: 'Russia', limit: 0.03, note: 'Enforces a strict baseline corresponding to 0.16 mg/L breath concentration.' },
      { code: 'ZA', name: 'South Africa', limit: 0.05, note: '0.02% limit for professional vehicle drivers.' },
      { code: 'IT', name: 'Italy', limit: 0.05, note: 'Stricter limit of 0.00% for novice drivers under 21.' },
      { code: 'IE', name: 'Ireland', limit: 0.05, note: 'Lower limit of 0.02% for learner, novice, and professional drivers.' },
      { code: 'CH', name: 'Switzerland', limit: 0.05, note: '0.01% limit for novice and professional drivers.' },
      { code: 'NZ', name: 'New Zealand', limit: 0.05, note: 'Stricter 0.00% limit for drivers under 20.' },
      { code: 'AE', name: 'United Arab Emirates', limit: 0.00, note: 'Strict zero tolerance across the entire federation.' },
      { code: 'SA', name: 'Saudi Arabia', limit: 0.00, note: 'Strict zero tolerance (alcohol is entirely illegal).' },
      { code: 'PK', name: 'Pakistan', limit: 0.00, note: 'Strict zero tolerance (alcohol is entirely illegal).' }
    ];

    // ─── State Management ───
    interface LoggedDrink {
      id: string;
      name: string;
      vol: number;
      abv: number;
      timeAgo: number;
      addedAt: number;
    }

    let userState = {
      gender: 'male',
      age: 30,
      weight: 75,
      weightUnit: 'kg',
      height: 175,
      heightUnit: 'cm',
      countryCode: 'US'
    };

    let loggedDrinks: LoggedDrink[] = [];
    let drinkCount = 1;
    let logUnlocked = false; // step 2 lock state
    let resultsUnlocked = false; // step 3 lock state
    let lastAddedDrinkId: string | null = null;

    // ─── Cache DOM References ───
    const elements = {
      // Lanes
      colProfile: document.getElementById('col-profile') as HTMLElement,
      colLog: document.getElementById('col-log') as HTMLElement,
      colResults: document.getElementById('col-results') as HTMLElement,

      // Tab Buttons (Progress tabs)
      tabResults: document.getElementById('tab-results') as HTMLElement,
      tabLog: document.getElementById('tab-log') as HTMLElement,
      tabProfile: document.getElementById('tab-profile') as HTMLElement,
      
      // Step numbers/visual indicators
      stepNum1: document.getElementById('step-num-1') as HTMLElement,
      stepTxt1: document.getElementById('step-txt-1') as HTMLElement,
      stepLine1: document.getElementById('step-line-1') as HTMLElement,
      stepNum2: document.getElementById('step-num-2') as HTMLElement,
      stepTxt2: document.getElementById('step-txt-2') as HTMLElement,
      stepLine2: document.getElementById('step-line-2') as HTMLElement,
      stepNum3: document.getElementById('step-num-3') as HTMLElement,
      stepTxt3: document.getElementById('step-txt-3') as HTMLElement,

      // Onboarding transition buttons
      btnToStep2: document.getElementById('btn-to-step-2') as HTMLButtonElement,
      btnToStep3: document.getElementById('btn-to-step-3') as HTMLButtonElement,

      // Results Lock Overlay
      resultsLockOverlay: document.getElementById('results-lock-overlay') as HTMLElement,
      resultsDashboardContent: document.getElementById('results-dashboard-content') as HTMLElement,

      // Log Lock Overlay
      logLockOverlay: document.getElementById('log-lock-overlay') as HTMLElement,
      logDashboardContent: document.getElementById('log-dashboard-content') as HTMLElement,

      // Modal Elements
      resultsModal: document.getElementById('results-modal') as HTMLElement,
      modalCard: document.getElementById('modal-card') as HTMLElement,
      btnCloseModal: document.getElementById('btn-close-modal') as HTMLButtonElement,
      btnCloseModalBottom: document.getElementById('btn-close-modal-bottom') as HTMLButtonElement,

      // Profile inputs
      btnMale: document.getElementById('btn-gender-male') as HTMLButtonElement,
      btnFemale: document.getElementById('btn-gender-female') as HTMLButtonElement,
      btnOther: document.getElementById('btn-gender-other') as HTMLButtonElement,
      ageSlider: document.getElementById('profile-age-slider') as HTMLInputElement,
      ageInput: document.getElementById('profile-age') as HTMLInputElement,
      ageLbl: document.getElementById('lbl-age-val') as HTMLElement,
      weightInput: document.getElementById('profile-weight') as HTMLInputElement,
      weightUnitLbl: document.getElementById('profile-weight-unit') as HTMLElement,
      btnKg: document.getElementById('btn-weight-kg') as HTMLButtonElement,
      btnLbs: document.getElementById('btn-weight-lbs') as HTMLButtonElement,
      heightInput: document.getElementById('profile-height') as HTMLInputElement,
      heightUnitLbl: document.getElementById('profile-height-unit') as HTMLElement,
      btnCm: document.getElementById('btn-height-cm') as HTMLButtonElement,
      btnIn: document.getElementById('btn-height-in') as HTMLButtonElement,
      countrySelect: document.getElementById('profile-country') as HTMLSelectElement,
      countryWarningBox: document.getElementById('out-country-warning-box') as HTMLElement,
      countryWarningText: document.getElementById('out-country-warning-text') as HTMLElement,
      
      // Drink Adder Form
      drinkSelect: document.getElementById('drink-select') as HTMLSelectElement,
      customLabelContainer: document.getElementById('custom-drink-label-container') as HTMLElement,
      drinkName: document.getElementById('drink-name') as HTMLInputElement,
      drinkVolume: document.getElementById('drink-volume') as HTMLInputElement,
      drinkVolumeUnit: document.getElementById('drink-volume-unit') as HTMLElement,
      btnVolMl: document.getElementById('btn-volume-ml') as HTMLButtonElement,
      btnVolOz: document.getElementById('btn-volume-oz') as HTMLButtonElement,
      abvSlider: document.getElementById('drink-abv-slider') as HTMLInputElement,
      abvInput: document.getElementById('drink-abv') as HTMLInputElement,
      abvLbl: document.getElementById('lbl-abv-val') as HTMLElement,
      timeAgoSlider: document.getElementById('drink-time-ago') as HTMLInputElement,
      timeAgoLbl: document.getElementById('drink-time-ago-label') as HTMLElement,
      btnAdd: document.getElementById('btn-add-drink') as HTMLButtonElement,
      btnClear: document.getElementById('btn-clear-timeline') as HTMLButtonElement,
      
      // Lists & Containers
      timelineList: document.getElementById('timeline-list') as HTMLUListElement,
      timelineEmpty: document.getElementById('timeline-empty-state') as HTMLElement,
      timelineContent: document.getElementById('timeline-content') as HTMLElement,
      timelineCount: document.getElementById('timeline-count') as HTMLElement,
      toastContainer: document.getElementById('toast-container') as HTMLElement
    };

    // ─── Initialization ───
    function init() {
      // Populate Country dropdown
      COUNTRIES.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.code;
        opt.textContent = `${c.name} (${c.limit.toFixed(2)}%)`;
        elements.countrySelect.appendChild(opt);
      });
      elements.countrySelect.value = userState.countryCode;

      // Select volume unit ML, weight unit KG, height unit CM as initial styling
      setActiveUnitButton(elements.btnVolMl, elements.btnVolOz);
      setActiveUnitButton(elements.btnKg, elements.btnLbs);
      setActiveUnitButton(elements.btnCm, elements.btnIn);

      // Attach event listeners
      setupListeners();

      // Initial view layout (Profile tab active first on mobile, results locked)
      setStepSelection(1);
      updateAll();

      // Staggered entrance for columns on desktop
      if (window.innerWidth >= 1024) {
        (animate as any)(elements.colProfile, { opacity: [0, 1], y: [20, 0] }, { duration: 0.6, easing: [0.16, 1, 0.3, 1] });
        (animate as any)(elements.colLog, { opacity: [0, 1], y: [20, 0] }, { duration: 0.6, delay: 0.1, easing: [0.16, 1, 0.3, 1] });
        (animate as any)(elements.colResults, { opacity: [0, 1], y: [20, 0] }, { duration: 0.6, delay: 0.2, easing: [0.16, 1, 0.3, 1] });
      }
    }

    // Helper: Manage button toggle styling in Vercel design
    function setActiveGenderButton(activeBtn: HTMLButtonElement) {
      [elements.btnMale, elements.btnFemale, elements.btnOther].forEach(btn => {
        btn.className = "py-1.5 text-xs font-medium rounded-xs text-body hover:text-ink transition-vercel focus:outline-none";
      });
      activeBtn.className = "py-1.5 text-xs font-medium rounded-xs text-primary bg-canvas shadow-vercel-2 border border-hairline/20 transition-vercel focus:outline-none";
    }

    function setActiveUnitButton(activeBtn: HTMLButtonElement, inactiveBtn: HTMLButtonElement) {
      activeBtn.className = "px-2 py-0.5 text-[10px] font-semibold font-mono rounded-xs text-primary bg-canvas shadow-vercel-1 border border-hairline/10 focus:outline-none";
      inactiveBtn.className = "px-2 py-0.5 text-[10px] font-semibold font-mono rounded-xs text-body hover:text-ink focus:outline-none";
    }

    // Set wizard active step indices and mobile lane tab toggles
    function setStepSelection(stepNum: number) {
      const isMobile = window.innerWidth < 1024;

      // 1. Manage mobile tab display lanes
      if (stepNum === 1) {
        elements.colProfile.className = "col-span-1 lg:col-span-4 space-y-6 block";
        elements.colLog.className = "col-span-1 lg:col-span-4 space-y-6 relative min-h-[500px] hidden lg:block";
        elements.colResults.className = "col-span-1 lg:col-span-4 space-y-6 relative min-h-[500px] hidden lg:block";

        if (isMobile) {
          (animate as any)(elements.colProfile, { opacity: [0, 1], y: [15, 0] }, { duration: 0.35, easing: [0.16, 1, 0.3, 1] });
        }
      } else if (stepNum === 2) {
        // Only allow switching to step 2 if log is unlocked
        if (!logUnlocked) {
          showToast('Please click "Next: Log Drinks" in Step 1 to unlock drink logging.');
          return;
        }
        elements.colProfile.className = "col-span-1 lg:col-span-4 space-y-6 hidden lg:block";
        elements.colLog.className = "col-span-1 lg:col-span-4 space-y-6 relative min-h-[500px] block";
        elements.colResults.className = "col-span-1 lg:col-span-4 space-y-6 relative min-h-[500px] hidden lg:block";

        if (isMobile) {
          (animate as any)(elements.colLog, { opacity: [0, 1], y: [15, 0] }, { duration: 0.35, easing: [0.16, 1, 0.3, 1] });
        }
      } else if (stepNum === 3) {
        // Only allow switching to step 3 on mobile if results are unlocked
        if (!resultsUnlocked) {
          showToast('Please click "Show BAC Results" in Step 2 to view analytics.');
          return;
        }
        elements.colProfile.className = "col-span-1 lg:col-span-4 space-y-6 hidden lg:block";
        elements.colLog.className = "col-span-1 lg:col-span-4 space-y-6 relative min-h-[500px] hidden lg:block";
        elements.colResults.className = "col-span-1 lg:col-span-4 space-y-6 relative min-h-[500px] block";

        if (isMobile) {
          (animate as any)(elements.colResults, { opacity: [0, 1], y: [15, 0] }, { duration: 0.35, easing: [0.16, 1, 0.3, 1] });
        }
      }

      // 2. Stepper Visual styling
      // Reset all
      [elements.stepNum1, elements.stepNum2, elements.stepNum3].forEach(n => {
        n.className = "w-7 h-7 rounded-full bg-canvas border border-hairline text-body text-xs font-semibold flex items-center justify-center transition-vercel";
      });
      [elements.stepTxt1, elements.stepTxt2, elements.stepTxt3].forEach(t => {
        t.className = "text-xs font-medium text-body";
      });
      elements.stepLine1.className = "flex-grow h-px bg-hairline mx-2";
      elements.stepLine2.className = "flex-grow h-px bg-hairline mx-2";

      elements.tabProfile.setAttribute('aria-selected', stepNum === 1 ? 'true' : 'false');
      elements.tabLog.setAttribute('aria-selected', stepNum === 2 ? 'true' : 'false');
      elements.tabResults.setAttribute('aria-selected', stepNum === 3 ? 'true' : 'false');

      // Highlight active step state
      if (stepNum === 1) {
        elements.stepNum1.className = "w-7 h-7 rounded-full bg-primary text-canvas-soft text-xs font-semibold flex items-center justify-center transition-vercel";
        elements.stepTxt1.className = "text-xs font-semibold text-primary";
      } else if (stepNum === 2) {
        elements.stepNum1.className = "w-7 h-7 rounded-full bg-primary/20 text-primary text-xs font-semibold flex items-center justify-center transition-vercel";
        elements.stepNum2.className = "w-7 h-7 rounded-full bg-primary text-canvas-soft text-xs font-semibold flex items-center justify-center transition-vercel";
        elements.stepTxt2.className = "text-xs font-semibold text-primary";
        elements.stepLine1.className = "flex-grow h-px bg-hairline-strong mx-2";
      } else if (stepNum === 3) {
        elements.stepNum1.className = "w-7 h-7 rounded-full bg-primary/20 text-primary text-xs font-semibold flex items-center justify-center transition-vercel";
        elements.stepNum2.className = "w-7 h-7 rounded-full bg-primary/20 text-primary text-xs font-semibold flex items-center justify-center transition-vercel";
        elements.stepNum3.className = "w-7 h-7 rounded-full bg-primary text-canvas-soft text-xs font-semibold flex items-center justify-center transition-vercel";
        elements.stepTxt3.className = "text-xs font-semibold text-primary";
        elements.stepLine1.className = "flex-grow h-px bg-hairline-strong mx-2";
        elements.stepLine2.className = "flex-grow h-px bg-hairline-strong mx-2";
      }
    }

    // ─── Event Listeners ───
    function setupListeners() {
      // Stepper Tab Button Clicks
      elements.tabProfile.addEventListener('click', () => setStepSelection(1));
      elements.tabLog.addEventListener('click', () => setStepSelection(2));
      elements.tabResults.addEventListener('click', () => setStepSelection(3));

      // Onboarding step progression CTAs
      elements.btnToStep2.addEventListener('click', () => {
        unlockStep2();
        setStepSelection(2);
      });
      
      // Dialog modal toggling (Show Results button)
      elements.btnToStep3.addEventListener('click', () => {
        if (loggedDrinks.length === 0) {
          showToast('Please add at least one drink to calculate BAC.');
          return;
        }
        calculateAndOpenModal();
      });

      // Modal close click handlers
      elements.btnCloseModal.addEventListener('click', closeModal);
      elements.btnCloseModalBottom.addEventListener('click', closeModal);
      
      // Close modal on outside click (Vercel UX design alignment)
      elements.resultsModal.addEventListener('click', (e) => {
        if (e.target === elements.resultsModal) {
          closeModal();
        }
      });

      // Keyboard Esc key close configuration
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !elements.resultsModal.classList.contains('hidden')) {
          closeModal();
        }
      });

      // Gender Toggles
      elements.btnMale.addEventListener('click', () => { userState.gender = 'male'; setActiveGenderButton(elements.btnMale); updateAll(); });
      elements.btnFemale.addEventListener('click', () => { userState.gender = 'female'; setActiveGenderButton(elements.btnFemale); updateAll(); });
      elements.btnOther.addEventListener('click', () => { userState.gender = 'other'; setActiveGenderButton(elements.btnOther); updateAll(); });

      // Age Inputs (sync range slider & numerical input)
      elements.ageSlider.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        elements.ageInput.value = target.value;
        elements.ageLbl.textContent = target.value;
        userState.age = parseInt(target.value, 10);
        updateAll();
      });
      elements.ageInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        let val = parseInt(target.value, 10);
        if (isNaN(val)) val = 16;
        if (val < 16) val = 16;
        if (val > 90) val = 90;
        elements.ageSlider.value = val.toString();
        elements.ageLbl.textContent = val.toString();
        userState.age = val;
        updateAll();
      });

      // Weight Units Toggle
      elements.btnKg.addEventListener('click', () => {
        if (userState.weightUnit === 'lbs') {
          userState.weightUnit = 'kg';
          setActiveUnitButton(elements.btnKg, elements.btnLbs);
          elements.weightUnitLbl.textContent = 'kg';
          let currentVal = parseFloat(elements.weightInput.value);
          elements.weightInput.value = Math.round(currentVal * 0.453592).toString();
          userState.weight = parseInt(elements.weightInput.value, 10);
          updateAll();
        }
      });
      elements.btnLbs.addEventListener('click', () => {
        if (userState.weightUnit === 'kg') {
          userState.weightUnit = 'lbs';
          setActiveUnitButton(elements.btnLbs, elements.btnKg);
          elements.weightUnitLbl.textContent = 'lbs';
          let currentVal = parseFloat(elements.weightInput.value);
          elements.weightInput.value = Math.round(currentVal / 0.453592).toString();
          userState.weight = parseInt(elements.weightInput.value, 10);
          updateAll();
        }
      });
      elements.weightInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        let val = parseFloat(target.value);
        if (isNaN(val)) val = 70;
        userState.weight = val;
        updateAll();
      });

      // Height Units Toggle
      elements.btnCm.addEventListener('click', () => {
        if (userState.heightUnit === 'in') {
          userState.heightUnit = 'cm';
          setActiveUnitButton(elements.btnCm, elements.btnIn);
          elements.heightUnitLbl.textContent = 'cm';
          let currentVal = parseFloat(elements.heightInput.value);
          elements.heightInput.value = Math.round(currentVal * 2.54).toString();
          userState.height = parseInt(elements.heightInput.value, 10);
          updateAll();
        }
      });
      elements.btnIn.addEventListener('click', () => {
        if (userState.heightUnit === 'cm') {
          userState.heightUnit = 'in';
          setActiveUnitButton(elements.btnIn, elements.btnCm);
          elements.heightUnitLbl.textContent = 'in';
          let currentVal = parseFloat(elements.heightInput.value);
          elements.heightInput.value = Math.round(currentVal / 2.54).toString();
          userState.height = parseInt(elements.heightInput.value, 10);
          updateAll();
        }
      });
      elements.heightInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        let val = parseFloat(target.value);
        if (isNaN(val)) val = 170;
        userState.height = val;
        updateAll();
      });

      // Country Select
      elements.countrySelect.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        userState.countryCode = target.value;
        const country = COUNTRIES.find(c => c.code === userState.countryCode);
        if (country) {
          elements.countryWarningText.innerHTML = `${country.name} legal limit is <span class="font-mono font-semibold">${country.limit.toFixed(2)}%</span> BAC. ${country.note}`;
        }
        updateAll();
      });

      // Drink select dropdown change handler
      elements.drinkSelect.addEventListener('change', populateFormFromSelection);

      // Drink volume units toggle
      elements.btnVolMl.addEventListener('click', () => {
        if (elements.drinkVolumeUnit.textContent === 'oz') {
          setActiveUnitButton(elements.btnVolMl, elements.btnVolOz);
          elements.drinkVolumeUnit.textContent = 'ml';
          let currentVal = parseFloat(elements.drinkVolume.value);
          elements.drinkVolume.value = Math.round(currentVal * 29.5735).toString();
        }
      });
      elements.btnVolOz.addEventListener('click', () => {
        if (elements.drinkVolumeUnit.textContent === 'ml') {
          setActiveUnitButton(elements.btnVolOz, elements.btnVolMl);
          elements.drinkVolumeUnit.textContent = 'oz';
          let currentVal = parseFloat(elements.drinkVolume.value);
          elements.drinkVolume.value = (currentVal / 29.5735).toFixed(1);
        }
      });

      // Drink ABV slider sync
      elements.abvSlider.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        elements.abvInput.value = target.value;
        elements.abvLbl.textContent = parseFloat(target.value).toFixed(1);
      });
      elements.abvInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        let val = parseFloat(target.value);
        if (isNaN(val)) val = 5.0;
        if (val < 0.1) val = 0.1;
        if (val > 100.0) val = 100.0;
        elements.abvSlider.value = val.toString();
        elements.abvLbl.textContent = val.toFixed(1);
      });

      // Drink time ago slider label updating
      elements.timeAgoSlider.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        let mins = parseInt(target.value, 10);
        if (mins === 0) {
          elements.timeAgoLbl.textContent = 'Just now';
        } else if (mins < 60) {
          elements.timeAgoLbl.textContent = `${mins} mins ago`;
        } else {
          let hrs = Math.floor(mins / 60);
          let remMins = mins % 60;
          elements.timeAgoLbl.textContent = remMins === 0 ? `${hrs}h ago` : `${hrs}h ${remMins}m ago`;
        }
      });

      // Add Drink Event
      elements.btnAdd.addEventListener('click', addDrinkFromForm);

      // Clear Timeline Event
      elements.btnClear.addEventListener('click', () => {
        loggedDrinks = [];
        drinkCount = 1;
        
        // Relock step 3 on clear
        resultsUnlocked = false;
        elements.resultsLockOverlay.classList.remove('opacity-0', 'pointer-events-none');
        elements.resultsDashboardContent.className = "space-y-6 opacity-30 pointer-events-none transition-vercel select-none";
        
        updateAll();
        showToast('Timeline cleared successfully.');
      });
    }

    // Populate the drink input form fields on dropdown select change
    function populateFormFromSelection() {
      const selectedOpt = elements.drinkSelect.options[elements.drinkSelect.selectedIndex];
      if (!selectedOpt) return;
      
      const valType = selectedOpt.value;
      const name = selectedOpt.getAttribute('data-name') || "";
      const volMl = parseFloat(selectedOpt.getAttribute('data-vol') || "0");
      const abv = parseFloat(selectedOpt.getAttribute('data-abv') || "0");
      
      // Update Name & toggle custom container visibility
      if (valType === 'custom') {
        elements.customLabelContainer.classList.remove('hidden');
        elements.drinkName.value = "Custom Drink";
        elements.drinkName.focus();
      } else {
        elements.customLabelContainer.classList.add('hidden');
        elements.drinkName.value = name;
      }
      
      // Update Volume (convert to OZ if currently selected unit is oz)
      const isOz = elements.drinkVolumeUnit.textContent === 'oz';
      if (isOz) {
        elements.drinkVolume.value = (volMl / 29.5735).toFixed(1);
      } else {
        elements.drinkVolume.value = volMl.toString();
      }
      
      // Update ABV
      elements.abvInput.value = abv.toString();
      elements.abvSlider.value = abv.toString();
      elements.abvLbl.textContent = abv.toFixed(1);
      
      // Highlight form elements container
      const container = elements.drinkVolume.parentElement?.parentElement?.parentElement;
      if (container) {
        container.classList.add('ring-2', 'ring-link/30');
        setTimeout(() => container.classList.remove('ring-2', 'ring-link/30'), 500);
      }
    }

    // Get biological values normalized to standard units (kg, cm)
    function getNormalizedBiology() {
      let weightKg = userState.weight;
      if (userState.weightUnit === 'lbs') {
        weightKg = weightKg * 0.45359237;
      }
      let heightCm = userState.height;
      if (userState.heightUnit === 'in') {
        heightCm = heightCm * 2.54;
      }
      return {
        gender: userState.gender,
        age: userState.age,
        weightKg,
        heightCm
      };
    }

    // ─── Dynamic Toast Notification System ───
    function showToast(message: string) {
      const toast = document.createElement('div');
      toast.className = "bg-canvas text-primary shadow-vercel-4 border border-hairline rounded-md py-3 px-4 flex items-center justify-between gap-3 text-sm font-sans select-none pointer-events-auto opacity-0 translate-y-4";
      toast.style.transition = "transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease-out";
      
      toast.innerHTML = `
        <div class="flex items-center gap-2">
          <svg class="h-4.5 w-4.5 text-success shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="font-medium truncate max-w-[220px]">${message}</span>
        </div>
        <button type="button" class="text-mute hover:text-ink focus:outline-none p-1 rounded-sm" aria-label="Close Notification">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      `;

      const closeBtn = toast.querySelector('button');
      if (closeBtn) {
        closeBtn.addEventListener('click', dismiss);
      }

      elements.toastContainer.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('opacity-0', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
      });

      const timeoutId = setTimeout(dismiss, 3000);

      function dismiss() {
        clearTimeout(timeoutId);
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'translate-y-4');
        toast.addEventListener('transitionend', () => {
          toast.remove();
        });
      }
    }

    // ─── Mathematical Estimator Calculations ───
    
    function calculateTBW(gender: string, weightKg: number, heightCm: number, ageYears: number): number {
      if (gender === 'male') {
        return 2.447 - (0.09516 * ageYears) + (0.1074 * heightCm) + (0.3362 * weightKg);
      } else if (gender === 'female') {
        return -2.097 + (0.1069 * heightCm) + (0.2466 * weightKg);
      } else {
        const male = 2.447 - (0.09516 * ageYears) + (0.1074 * heightCm) + (0.3362 * weightKg);
        const female = -2.097 + (0.1069 * heightCm) + (0.2466 * weightKg);
        return (male + female) / 2;
      }
    }

    function formatTimeLabel(relativeHours: number): string {
      const now = new Date();
      now.setSeconds(0);
      now.setMilliseconds(0);
      
      const targetTime = new Date(now.getTime() + (relativeHours * 60 * 60 * 1000));
      let h = targetTime.getHours();
      let m: number | string = targetTime.getMinutes();
      const ampm = h >= 12 ? 'PM' : 'AM';
      h = h % 12;
      h = h ? h : 12;
      m = m < 10 ? '0' + m : m;
      return `${h}:${m} ${ampm}`;
    }

    function calculateBACAt(H: number, drinksList: LoggedDrink[], tbwLiters: number): number {
      if (drinksList.length === 0) return 0;
      
      let totalBAC = 0;
      const beta = 0.015;
      const absorptionTime = 0.75;
      
      drinksList.forEach(drink => {
        const consumptionHour = - (drink.timeAgo / 60);
        const elapsedHours = H - consumptionHour;
        
        if (elapsedHours < 0) return;

        const pureAlcoholGrams = drink.vol * (drink.abv / 100) * 0.789;
        const peakBACContribution = (pureAlcoholGrams * 0.8) / (tbwLiters * 10);
        const absorptionFraction = Math.min(1, elapsedHours / absorptionTime);
        const contribution = (absorptionFraction * peakBACContribution) - (beta * elapsedHours);
        
        if (contribution > 0) {
          totalBAC += contribution;
        }
      });
      
      return totalBAC;
    }

    // ─── Drink Adder Form Action ───
    function addDrinkFromForm() {
      const name = elements.drinkName.value.trim() || `Drink #${drinkCount}`;
      let vol = parseFloat(elements.drinkVolume.value);
      const abv = parseFloat(elements.abvInput.value);
      const timeAgo = parseInt(elements.timeAgoSlider.value, 10);
      
      if (isNaN(vol) || vol <= 0) return;
      if (isNaN(abv) || abv <= 0) return;
      
      if (elements.drinkVolumeUnit.textContent === 'oz') {
        vol = vol * 29.5735;
      }
      
      const newDrink = {
        id: 'drink-' + Date.now() + '-' + Math.floor(Math.random() * 1000),
        name,
        vol,
        abv,
        timeAgo,
        addedAt: Date.now() - (timeAgo * 60 * 1000)
      };
      
      lastAddedDrinkId = newDrink.id;
      loggedDrinks.push(newDrink);
      drinkCount++;
      
      // Toast notification trigger (But do NOT update visual result directly on page yet)
      showToast(`${name} added to timeline.`);
      
      // Reset form variables to default
      elements.drinkSelect.value = "beer-reg";
      elements.customLabelContainer.classList.add('hidden');
      elements.drinkName.value = "Regular Beer";
      elements.drinkVolume.value = "355";
      elements.drinkVolumeUnit.textContent = "ml";
      setActiveUnitButton(elements.btnVolMl, elements.btnVolOz);
      elements.abvInput.value = "5.0";
      elements.abvSlider.value = "5.0";
      elements.abvLbl.textContent = "5.0";
      elements.timeAgoSlider.value = "0";
      elements.timeAgoLbl.textContent = "Just now";
      
      // Update logged list display
      renderTimeline();
 
      // If results were unlocked previously, re-lock them until user recalculates explicitly
      if (resultsUnlocked) {
        resultsUnlocked = false;
        elements.resultsLockOverlay.classList.remove('opacity-0', 'pointer-events-none');
        elements.resultsDashboardContent.className = "space-y-6 opacity-30 pointer-events-none transition-vercel select-none";
      }
    }

    function removeDrink(id: string, name: string): void {
      loggedDrinks = loggedDrinks.filter(d => d.id !== id);
      renderTimeline();
      showToast(`${name} removed from log.`);
      
      // Re-lock if timeline changed
      if (resultsUnlocked) {
        resultsUnlocked = false;
        elements.resultsLockOverlay.classList.remove('opacity-0', 'pointer-events-none');
        elements.resultsDashboardContent.className = "space-y-6 opacity-30 pointer-events-none transition-vercel select-none";
      }
    }

    // ─── Modal & Calculation Progression Toggling ───

    function calculateAndOpenModal() {
      // 1. Calculate values
      const bio = getNormalizedBiology();
      const tbw = calculateTBW(bio.gender, bio.weightKg, bio.heightCm, bio.age);
      
      const nowMs = Date.now();
      loggedDrinks.forEach(drink => {
        const elapsedMins = Math.round((nowMs - drink.addedAt) / 60000);
        drink.timeAgo = Math.max(0, elapsedMins);
      });

      let earliestDrinkAgo = 0;
      loggedDrinks.forEach(d => {
        if (d.timeAgo > earliestDrinkAgo) earliestDrinkAgo = d.timeAgo;
      });
      const startHour = -(earliestDrinkAgo / 60) - 0.5;
      
      let peakBAC = 0;
      let peakHour = 0;
      let currentBAC = calculateBACAt(0, loggedDrinks, tbw);
      let soberHour: number | null = null;
      let safeHour: number | null = null;
      
      const country = COUNTRIES.find(c => c.code === userState.countryCode);
      if (!country) return;
      const limit = country.limit;

      const scanPoints: { h: number; val: number }[] = [];
      const scanStep = 0.05;
      const endScan = 16.0;
      
      for (let h = startHour; h <= endScan; h += scanStep) {
        const val = calculateBACAt(h, loggedDrinks, tbw);
        scanPoints.push({ h, val });
        
        if (val > peakBAC) {
          peakBAC = val;
          peakHour = h;
        }
        
        if (h >= 0) {
          if (soberHour === null && val <= 0.0001) {
            soberHour = h;
          }
          if (safeHour === null && val < limit) {
            safeHour = h;
          }
        }
      }

      // 2. Render Results inside the Modal container
      updateUIContainer('modal-', currentBAC, peakBAC, limit, soberHour, safeHour, peakHour, scanPoints, startHour, country.name);

      // 3. Render Results inside the main Dashboard container (will be unlocked)
      updateUIContainer('out-', currentBAC, peakBAC, limit, soberHour, safeHour, peakHour, scanPoints, startHour, country.name);

      // 4. Open Modal Dialog
      elements.resultsModal.classList.remove('hidden');
      elements.resultsModal.classList.add('flex');
      document.body.style.overflow = 'hidden'; // Lock scrolling
      
      elements.modalCard.classList.remove('scale-95', 'opacity-0');
      
      // Smooth animated entry for modal overlay and card
      (animate as any)(elements.resultsModal, { opacity: [0, 1] }, { duration: 0.25 });
      (animate as any)(elements.modalCard, { scale: [0.95, 1], y: [15, 0], opacity: [0, 1] }, { 
        duration: 0.45, 
        easing: [0.16, 1, 0.3, 1]
      });
    }

    function closeModal() {
      // Smooth animated exit for modal overlay and card
      Promise.all([
        (animate as any)(elements.resultsModal, { opacity: 0 }, { duration: 0.2 }),
        (animate as any)(elements.modalCard, { scale: 0.95, y: 15, opacity: 0 }, { duration: 0.2 })
      ]).then(() => {
        elements.resultsModal.classList.remove('flex');
        elements.resultsModal.classList.add('hidden');
        document.body.style.overflow = ''; // Restore scrolling
        
        elements.modalCard.classList.add('scale-95', 'opacity-0');
 
        // Unlock Step 3 (Results) on the main page
        resultsUnlocked = true;
        
        // Fade out overlay and fade in dashboard content
        (animate as any)(elements.resultsLockOverlay, { opacity: 0, scale: 0.95 }, { duration: 0.3 }).then(() => {
          elements.resultsLockOverlay.classList.add('pointer-events-none');
        });
        
        elements.resultsDashboardContent.classList.remove('pointer-events-none', 'select-none');
        (animate as any)(elements.resultsDashboardContent, { opacity: [0.3, 1] }, { duration: 0.5, easing: "ease-out" });
        
        // Auto navigate to Step 3 tab on mobile viewports
        setStepSelection(3);
      });
    }

    function unlockStep2() {
      if (logUnlocked) return;
      logUnlocked = true;

      // Animate unlock overlay fading out
      (animate as any)(elements.logLockOverlay, { opacity: 0, scale: 0.95 }, { duration: 0.3 }).then(() => {
        elements.logLockOverlay.classList.add('pointer-events-none');
      });

      // Animate content fading in
      elements.logDashboardContent.classList.remove('pointer-events-none', 'select-none');
      (animate as any)(elements.logDashboardContent, { opacity: [0.3, 1] }, { duration: 0.5, easing: "ease-out" });
    }

    // ─── Dynamic Layout Rendering Engine ───
    
    function updateUIContainer(
      prefix: string,
      currentBAC: number,
      peakBAC: number,
      limit: number,
      soberHour: number | null,
      safeHour: number | null,
      peakHour: number,
      scanPoints: { h: number; val: number }[],
      startHour: number,
      countryName: string
    ) {
      // Query DOM nodes dynamically
      const elCurrent = document.getElementById(`${prefix}bac-current`);
      const elSober = document.getElementById(`${prefix}time-sober`);
      const elSafe = document.getElementById(`${prefix}time-safe`);
      const elPeak = document.getElementById(`${prefix}bac-peak`);
      const elPeakTime = document.getElementById(`${prefix}bac-peak-time`);
      const elBadge = document.getElementById(`${prefix}safety-badge`);
      const elBadgeDot = document.getElementById(`${prefix}safety-badge-dot`);
      const elBadgeText = document.getElementById(`${prefix}safety-badge-text`);
      const elAlert = document.getElementById(`${prefix}safety-alert`);
      const elAlertTitle = document.getElementById(`${prefix}safety-alert-title`);
      const elAlertDesc = document.getElementById(`${prefix}safety-alert-desc`);

      // Set digital values (animated count-up)
      if (elCurrent) {
        (animate as any)(0, currentBAC, {
          duration: 0.8,
          easing: [0.16, 1, 0.3, 1],
          onUpdate: (latest: number) => {
            elCurrent.textContent = `${latest.toFixed(3)}%`;
          }
        });
      }
      if (elPeak) {
        (animate as any)(0, peakBAC, {
          duration: 0.8,
          easing: [0.16, 1, 0.3, 1],
          onUpdate: (latest: number) => {
            elPeak.textContent = `${latest.toFixed(3)}%`;
          }
        });
      }

      // Set peak time label
      if (elPeakTime) {
        if (peakHour === 0) {
          elPeakTime.textContent = "Now";
        } else if (peakHour < 0) {
          let mins = Math.round(Math.abs(peakHour) * 60);
          elPeakTime.textContent = `${mins}m ago`;
        } else {
          elPeakTime.textContent = formatTimeLabel(peakHour);
        }
      }

      // Set sober countdown
      if (elSober) {
        if (currentBAC <= 0.0001) {
          elSober.textContent = "Sober";
        } else if (soberHour !== null) {
          let totalMins = Math.round(soberHour * 60);
          let hrs = Math.floor(totalMins / 60);
          let mins = totalMins % 60;
          elSober.textContent = hrs > 0 ? `${hrs}h ${mins}m (${formatTimeLabel(soberHour)})` : `${mins}m (${formatTimeLabel(soberHour)})`;
        } else {
          elSober.textContent = "12h+";
        }
      }

      // Set safe countdown
      if (elSafe) {
        if (currentBAC < limit) {
          elSafe.textContent = "Safe Now";
        } else if (safeHour !== null) {
          let totalMins = Math.round(safeHour * 60);
          let hrs = Math.floor(totalMins / 60);
          let mins = totalMins % 60;
          elSafe.textContent = hrs > 0 ? `${hrs}h ${mins}m (${formatTimeLabel(safeHour)})` : `${mins}m (${formatTimeLabel(safeHour)})`;
        } else {
          elSafe.textContent = "12h+";
        }
      }

      // Set Badge & Advisory card states
      if (currentBAC >= limit) {
        if (elBadge) elBadge.className = "inline-flex items-center gap-1.5 px-3 py-1 mt-4 text-xs font-mono font-semibold rounded-pill tracking-wide bg-error/10 text-error border border-error/15";
        if (elBadgeDot) elBadgeDot.className = "w-1.5 h-1.5 rounded-full bg-error animate-ping";
        if (elBadgeText) elBadgeText.textContent = "Over Legal Limit";
        
        if (elAlert) elAlert.className = "mt-4 p-4 rounded-sm transition-vercel shadow-vercel-1 bg-error-soft text-error-deep border border-error/10";
        if (elAlertTitle) elAlertTitle.textContent = "DO NOT DRIVE";
        if (elAlertTitle) elAlertTitle.className = "font-sans text-xs font-semibold uppercase tracking-wider mb-1 text-error-deep";
        if (elAlertDesc) elAlertDesc.textContent = `Your blood alcohol concentration is above the legal limit of ${limit.toFixed(2)}% in ${countryName}. Driving is strictly illegal, dangerous, and carries severe criminal penalties.`;
      } else if (currentBAC > 0.0001) {
        if (elBadge) elBadge.className = "inline-flex items-center gap-1.5 px-3 py-1 mt-4 text-xs font-mono font-semibold rounded-pill tracking-wide bg-warning/10 text-warning border border-warning/15";
        if (elBadgeDot) elBadgeDot.className = "w-1.5 h-1.5 rounded-full bg-warning";
        if (elBadgeText) elBadgeText.textContent = "Impaired (Below Limit)";
        
        if (elAlert) elAlert.className = "mt-4 p-4 rounded-sm transition-vercel shadow-vercel-1 bg-warning-soft text-warning-deep border border-warning/10";
        if (elAlertTitle) elAlertTitle.textContent = "CAUTION ADVISED";
        if (elAlertTitle) elAlertTitle.className = "font-sans text-xs font-semibold uppercase tracking-wider mb-1 text-warning-deep";
        if (elAlertDesc) elAlertDesc.textContent = `Your BAC of ${currentBAC.toFixed(3)}% is below the legal limit of ${limit.toFixed(2)}% in ${countryName}. However, cognitive and motor skills remain impaired. We advise waiting until you are completely sober (0.00%).`;
      } else if (peakBAC > 0.0001) {
        if (elBadge) elBadge.className = "inline-flex items-center gap-1.5 px-3 py-1 mt-4 text-xs font-mono font-semibold rounded-pill tracking-wide bg-warning/10 text-warning border border-warning/15";
        if (elBadgeDot) elBadgeDot.className = "w-1.5 h-1.5 rounded-full bg-warning animate-pulse";
        if (elBadgeText) elBadgeText.textContent = "Alcohol Absorbing";
        
        if (elAlert) elAlert.className = "mt-4 p-4 rounded-sm transition-vercel shadow-vercel-1 bg-warning-soft text-warning-deep border border-warning/10";
        if (elAlertTitle) elAlertTitle.textContent = "BAC RISING";
        if (elAlertTitle) elAlertTitle.className = "font-sans text-xs font-semibold uppercase tracking-wider mb-1 text-warning-deep";
        if (elAlertDesc) elAlertDesc.textContent = `You are currently under the limit, but alcohol is still absorbing. Your BAC is projected to peak at ${peakBAC.toFixed(3)}%. Do not operate a vehicle.`;
      } else {
        if (elBadge) elBadge.className = "inline-flex items-center gap-1.5 px-3 py-1 mt-4 text-xs font-mono font-semibold rounded-pill tracking-wide bg-success/10 text-success border border-success/15";
        if (elBadgeDot) elBadgeDot.className = "w-1.5 h-1.5 rounded-full bg-success";
        if (elBadgeText) elBadgeText.textContent = "Sober";
        
        if (elAlert) elAlert.className = "mt-4 p-4 rounded-sm transition-vercel shadow-vercel-1 bg-canvas-soft border border-hairline";
        if (elAlertTitle) elAlertTitle.textContent = "Sober";
        if (elAlertTitle) elAlertTitle.className = "font-sans text-xs font-semibold uppercase tracking-wider mb-1 text-primary";
        if (elAlertDesc) elAlertDesc.textContent = "No alcohol detected in blood. It is legally safe to operate a vehicle, provided you feel fit, alert, and rested.";
      }

      // Draw SVG Line Chart for this container context
      drawChartForContainer(prefix, scanPoints, startHour, limit, currentBAC, yMaxVal(scanPoints, limit));
    }

    // Get maximum Y value head room
    function yMaxVal(points: { h: number; val: number }[], limit: number): number {
      let maxVal = Math.max(...points.map(p => p.val));
      if (maxVal < limit) maxVal = limit;
      if (maxVal < 0.04) maxVal = 0.04;
      return maxVal * 1.25;
    }

    // Dynamic drawing function for horizontal and vertical axis plots
    function drawChartForContainer(
      prefix: string,
      points: { h: number; val: number }[],
      startHour: number,
      limit: number,
      currentBAC: number,
      yMax: number
    ): void {
      const isModal = prefix === 'modal-';
      const baselineY = isModal ? 180 : 220; // different container height variables
      const scaleHeight = isModal ? 160 : 200;

      const tMin = startHour;
      let tMax = 8.0;
      const maxPoint = points.find(p => p.h >= 0 && p.val <= 0.0001);
      if (maxPoint && maxPoint.h > tMax) {
        tMax = Math.ceil(maxPoint.h) + 1.0;
      }
      
      const displayPoints = points.filter(p => p.h >= tMin && p.h <= tMax);

      function getX(h: number): number {
        return 50 + ((h - tMin) / (tMax - tMin)) * 700;
      }
      
      function getY(val: number): number {
        return baselineY - (val / yMax) * scaleHeight;
      }

      // Select targets
      const pathLine = document.getElementById(`${prefix}chart-line-path`) as SVGPathElement | null;
      const pathArea = document.getElementById(`${prefix}chart-area-path`) as SVGPathElement | null;
      const lineLimit = document.getElementById(`${prefix}chart-limit-line`);
      const lblLimit = document.getElementById(`${prefix}chart-limit-label`);
      const lineNow = document.getElementById(`${prefix}chart-now-line`);
      const lblNow = document.getElementById(`${prefix}chart-now-label`);
      const dotPulse = document.getElementById(`${prefix}chart-pulse-dot`);
      const ringPulse = document.getElementById(`${prefix}chart-pulse-ring`);
      const xAxis = document.getElementById(`${prefix}chart-x-axis`);

      // Update Y Labels
      const lblY1 = document.getElementById(`${prefix}chart-y-label-1`);
      const lblY2 = document.getElementById(`${prefix}chart-y-label-2`);
      const lblY3 = document.getElementById(`${prefix}chart-y-label-3`);
      const lblY4 = document.getElementById(`${prefix}chart-y-label-4`);

      if (lblY1) lblY1.textContent = `${(yMax * 0.25).toFixed(3)}%`;
      if (lblY2) lblY2.textContent = `${(yMax * 0.50).toFixed(3)}%`;
      if (lblY3) lblY3.textContent = `${(yMax * 0.75).toFixed(3)}%`;
      if (lblY4) lblY4.textContent = `${(yMax).toFixed(3)}%`;

      if (displayPoints.length === 0) return;

      // Draw path
      let lineD = "";
      let areaD = "";
      displayPoints.forEach((p, idx) => {
        const x = getX(p.h);
        const y = getY(p.val);
        if (idx === 0) {
          lineD = `M ${x} ${y}`;
          areaD = `M ${x} ${baselineY} L ${x} ${y}`;
        } else {
          lineD += ` L ${x} ${y}`;
          areaD += ` L ${x} ${y}`;
        }
      });
      const endX = getX(displayPoints[displayPoints.length - 1].h);
      areaD += ` L ${endX} ${baselineY} Z`;

      if (pathLine) {
        pathLine.setAttribute('d', lineD);
        try {
          const pathLength = pathLine.getTotalLength();
          pathLine.style.strokeDasharray = pathLength.toString();
          (animate as any)(pathLine, { strokeDashoffset: [pathLength, 0] }, { duration: 0.8, easing: "ease-out" });
        } catch (e) {
          // Fallback if SVG isn't fully rendered in some environments
        }
      }
      if (pathArea) {
        pathArea.setAttribute('d', areaD);
        (animate as any)(pathArea, { opacity: [0, 1] }, { duration: 0.8, easing: "ease-out" });
      }

      // Position Limit Line
      const yLimit = getY(limit);
      if (lineLimit) {
        lineLimit.setAttribute('y1', yLimit.toString());
        lineLimit.setAttribute('y2', yLimit.toString());
      }
      if (lblLimit) {
        lblLimit.setAttribute('y', (yLimit - 5).toString());
        lblLimit.textContent = `LIMIT (${limit.toFixed(2)}%)`;
        if (limit === 0) lblLimit.setAttribute('y', (baselineY - 10).toString());
      }

      // Position "Now" Line
      const xNow = getX(0);
      if (lineNow) {
        lineNow.setAttribute('x1', xNow.toString());
        lineNow.setAttribute('x2', xNow.toString());
      }
      if (lblNow) lblNow.setAttribute('x', (xNow + 5).toString());

      // Pulse Indicator Dot
      const yNow = getY(currentBAC);
      if (dotPulse) {
        dotPulse.setAttribute('cx', xNow.toString());
        dotPulse.setAttribute('cy', yNow.toString());
      }
      if (ringPulse) {
        ringPulse.setAttribute('cx', xNow.toString());
        ringPulse.setAttribute('cy', yNow.toString());
      }

      // Render X labels
      if (xAxis) {
        xAxis.innerHTML = "";
        const intervals = [tMin, 0, tMax * 0.25, tMax * 0.50, tMax * 0.75, tMax];
        intervals.forEach(h => {
          const x = getX(h);
          const txt = document.createElementNS("http://www.w3.org/2000/svg", "text");
          txt.setAttribute('x', x.toString());
          txt.setAttribute('y', (baselineY + 20).toString());
          
          if (Math.abs(h) < 0.01) {
            txt.setAttribute('fill', '#171717');
            txt.setAttribute('font-weight', 'bold');
            txt.textContent = "Now";
          } else if (h < 0) {
            let mins = Math.round(Math.abs(h) * 60);
            txt.textContent = mins < 60 ? `-${mins}m` : `-${Math.round(Math.abs(h))}h`;
          } else {
            txt.textContent = `+${Math.round(h)}h`;
          }
          xAxis.appendChild(txt);
        });
      }
    }



    // Render logged drinks list
    function renderTimeline() {
      elements.timelineList.innerHTML = "";
      
      if (loggedDrinks.length === 0) {
        elements.timelineEmpty.classList.remove('hidden');
        elements.timelineContent.classList.add('hidden');
        elements.timelineCount.textContent = "0 drinks logged";
        return;
      }
      
      elements.timelineEmpty.classList.add('hidden');
      elements.timelineContent.classList.remove('hidden');
      elements.timelineCount.textContent = `${loggedDrinks.length} drink${loggedDrinks.length > 1 ? 's' : ''} logged`;

      const sortedDrinks = [...loggedDrinks].sort((a, b) => a.timeAgo - b.timeAgo);

      sortedDrinks.forEach(drink => {
        const li = document.createElement('li');
        li.className = "py-3 flex items-center justify-between group transition-vercel";
        
        const grams = (drink.vol * (drink.abv / 100) * 0.789).toFixed(1);
        
        let timeLabel = "Just now";
        if (drink.timeAgo > 0) {
          if (drink.timeAgo < 60) {
            timeLabel = `${drink.timeAgo}m ago`;
          } else {
            const hrs = Math.floor(drink.timeAgo / 60);
            const mins = drink.timeAgo % 60;
            timeLabel = mins === 0 ? `${hrs}h ago` : `${hrs}h ${mins}m ago`;
          }
        }

        let icon = "🍹";
        const nameLower = drink.name.toLowerCase();
        if (nameLower.includes('beer')) icon = "🍺";
        else if (nameLower.includes('wine')) icon = "🍷";
        else if (nameLower.includes('spirit') || nameLower.includes('shot') || nameLower.includes('whiskey') || nameLower.includes('vodka')) icon = "🥃";
        else if (nameLower.includes('cocktail') || nameLower.includes('margarita')) icon = "🍸";

        li.innerHTML = `
          <div class="flex items-center gap-3 min-w-0 flex-grow">
            <span class="text-xl select-none" aria-hidden="true">${icon}</span>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-primary truncate leading-tight">${drink.name}</p>
              <p class="text-xs text-mute mt-0.5 truncate font-sans">
                ${drink.vol.toFixed(0)} ml · ${drink.abv.toFixed(1)}% ABV · <span class="font-mono">${grams}g alc</span>
              </p>
            </div>
          </div>
          <div class="flex items-center gap-3 shrink-0 ml-3">
            <span class="text-xs font-mono text-body font-medium whitespace-nowrap tabular-nums">${timeLabel}</span>
            <button type="button" class="text-mute hover:text-error p-1 focus:outline-none focus:ring-1 focus:ring-error rounded-sm transition-vercel" data-id="${drink.id}" data-name="${drink.name}" aria-label="Remove ${drink.name} from log">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        `;
        
        const removeBtn = li.querySelector('button');
        if (removeBtn) {
          removeBtn.addEventListener('click', () => {
            removeDrink(drink.id, drink.name);
          });
        }

        elements.timelineList.appendChild(li);
        
        // If this drink was just added, animate its entry
        if (drink.id === lastAddedDrinkId) {
          (animate as any)(li, { opacity: [0, 1], y: [15, 0] }, { duration: 0.35, easing: [0.16, 1, 0.3, 1] });
        }
      });
      
      // Reset the tracking variable after rendering
      lastAddedDrinkId = null;
    }

    function updateAll() {
      // Re-normalizes time offsets relative to elapsed page session duration
      const nowMs = Date.now();
      loggedDrinks.forEach(drink => {
        const elapsedMins = Math.round((nowMs - drink.addedAt) / 60000);
        drink.timeAgo = Math.max(0, elapsedMins);
      });
      renderTimeline();
    }

    // ─── FAQ Accordion Interactivity ───
    const faqTriggers = document.querySelectorAll('[data-faq-trigger]');
    faqTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('[data-faq-item]');
        if (!item) return;
        const content = item.querySelector('[data-faq-content]') as HTMLElement;
        const icon = item.querySelector('[data-faq-icon]');
        const expanded = trigger.getAttribute('aria-expanded') === 'true';

        if (!content || !icon) return;

        // Close all other accordions first (Vercel clean UX)
        document.querySelectorAll('[data-faq-item]').forEach(otherItem => {
          if (otherItem !== item) {
            const otherTrigger = otherItem.querySelector('[data-faq-trigger]');
            const otherContent = otherItem.querySelector('[data-faq-content]') as HTMLElement;
            const otherIcon = otherItem.querySelector('[data-faq-icon]');
            
            if (otherTrigger && otherContent && otherIcon) {
              otherTrigger.setAttribute('aria-expanded', 'false');
              otherIcon.classList.remove('rotate-180');
              otherContent.style.maxHeight = '0px';
            }
          }
        });

        // Toggle current accordion
        if (expanded) {
          trigger.setAttribute('aria-expanded', 'false');
          icon.classList.remove('rotate-180');
          content.style.maxHeight = '0px';
        } else {
          trigger.setAttribute('aria-expanded', 'true');
          icon.classList.add('rotate-180');
          content.style.maxHeight = content.scrollHeight + 'px';
        }
      });
    });

    init();
  </script>
</Layout>

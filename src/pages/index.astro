      { code: 'CH', name: 'Switzerland', limit: 0.05, note: '0.01% limit for novice and professional drivers.' },
      { code: 'NZ', name: 'New Zealand', limit: 0.05, note: 'Stricter 0.00% limit for drivers under 20.' },
      { code: 'AE', name: 'United Arab Emirates', limit: 0.00, note: 'Strict zero tolerance across the entire federation.' },
      { code: 'SA', name: 'Saudi Arabia', limit: 0.00, note: 'Strict zero tolerance (alcohol is entirely illegal).' },
      { code: 'PK', name: 'Pakistan', limit: 0.00, note: 'Strict zero tolerance (alcohol is entirely illegal).' }
    ];

    // ─── State Management ───
    interface LoggedDrink {
      id: string;
      name: string;
      vol: number;
      abv: number;
      timeAgo: number;
      addedAt: number;
    }

    let userState = {
      gender: 'male',
      age: 30,
      weight: 75,
      weightUnit: 'kg',
      height: 175,
      heightUnit: 'cm',
      countryCode: 'US'
    };

    let loggedDrinks: LoggedDrink[] = [];
    let drinkCount = 1;
    let logUnlocked = false; // step 2 lock state
    let resultsUnlocked = false; // step 3 lock state
    let lastAddedDrinkId: string | null = null;

    // ─── Cache DOM References ───
    const elements = {
      // Lanes
      colProfile: document.getElementById('col-profile') as HTMLElement,
      colLog: document.getElementById('col-log') as HTMLElement,
      colResults: document.getElementById('col-results') as HTMLElement,

      // Tab Buttons (Progress tabs)
      tabResults: document.getElementById('tab-results') as HTMLElement,
      tabLog: document.getElementById('tab-log') as HTMLElement,
      tabProfile: document.getElementById('tab-profile') as HTMLElement,
      
      // Step numbers/visual indicators
      stepNum1: document.getElementById('step-num-1') as HTMLElement,
      stepTxt1: document.getElementById('step-txt-1') as HTMLElement,
      stepLine1: document.getElementById('step-line-1') as HTMLElement,
      stepNum2: document.getElementById('step-num-2') as HTMLElement,
      stepTxt2: document.getElementById('step-txt-2') as HTMLElement,
      stepLine2: document.getElementById('step-line-2') as HTMLElement,
      stepNum3: document.getElementById('step-num-3') as HTMLElement,
      stepTxt3: document.getElementById('step-txt-3') as HTMLElement,

      // Onboarding transition buttons
      btnToStep2: document.getElementById('btn-to-step-2') as HTMLButtonElement,
      btnToStep3: document.getElementById('btn-to-step-3') as HTMLButtonElement,

      // Results Lock Overlay
      resultsLockOverlay: document.getElementById('results-lock-overlay') as HTMLElement,
      resultsDashboardContent: document.getElementById('results-dashboard-content') as HTMLElement,

      // Log Lock Overlay
      logLockOverlay: document.getElementById('log-lock-overlay') as HTMLElement,
      logDashboardContent: document.getElementById('log-dashboard-content') as HTMLElement,

      // Modal Elements
      resultsModal: document.getElementById('results-modal') as HTMLElement,
      modalCard: document.getElementById('modal-card') as HTMLElement,
      btnCloseModal: document.getElementById('btn-close-modal') as HTMLButtonElement,
      btnCloseModalBottom: document.getElementById('btn-close-modal-bottom') as HTMLButtonElement,

      // Profile inputs
      btnMale: document.getElementById('btn-gender-male') as HTMLButtonElement,
      btnFemale: document.getElementById('btn-gender-female') as HTMLButtonElement,
      btnOther: document.getElementById('btn-gender-other') as HTMLButtonElement,
      ageSlider: document.getElementById('profile-age-slider') as HTMLInputElement,
      ageInput: document.getElementById('profile-age') as HTMLInputElement,
      ageLbl: document.getElementById('lbl-age-val') as HTMLElement,
      weightInput: document.getElementById('profile-weight') as HTMLInputElement,
      weightUnitLbl: document.getElementById('profile-weight-unit') as HTMLElement,
      btnKg: document.getElementById('btn-weight-kg') as HTMLButtonElement,
      btnLbs: document.getElementById('btn-weight-lbs') as HTMLButtonElement,
      heightInput: document.getElementById('profile-height') as HTMLInputElement,
      heightUnitLbl: document.getElementById('profile-height-unit') as HTMLElement,
      btnCm: document.getElementById('btn-height-cm') as HTMLButtonElement,
      btnIn: document.getElementById('btn-height-in') as HTMLButtonElement,
      countrySelect: document.getElementById('profile-country') as HTMLSelectElement,
      countryWarningBox: document.getElementById('out-country-warning-box') as HTMLElement,
      countryWarningText: document.getElementById('out-country-warning-text') as HTMLElement,
      
      // Drink Adder Form
      drinkSelect: document.getElementById('drink-select') as HTMLSelectElement,
      customLabelContainer: document.getElementById('custom-drink-label-container') as HTMLElement,
      drinkName: document.getElementById('drink-name') as HTMLInputElement,
      drinkVolume: document.getElementById('drink-volume') as HTMLInputElement,
      drinkVolumeUnit: document.getElementById('drink-volume-unit') as HTMLElement,
      btnVolMl: document.getElementById('btn-volume-ml') as HTMLButtonElement,
      btnVolOz: document.getElementById('btn-volume-oz') as HTMLButtonElement,
      abvSlider: document.getElementById('drink-abv-slider') as HTMLInputElement,
      abvInput: document.getElementById('drink-abv') as HTMLInputElement,
      abvLbl: document.getElementById('lbl-abv-val') as HTMLElement,
      timeAgoSlider: document.getElementById('drink-time-ago') as HTMLInputElement,
      timeAgoLbl: document.getElementById('drink-time-ago-label') as HTMLElement,
      btnAdd: document.getElementById('btn-add-drink') as HTMLButtonElement,
      btnClear: document.getElementById('btn-clear-timeline') as HTMLButtonElement,
      
      // Lists & Containers
      timelineList: document.getElementById('timeline-list') as HTMLUListElement,
      timelineEmpty: document.getElementById('timeline-empty-state') as HTMLElement,
      timelineContent: document.getElementById('timeline-content') as HTMLElement,
      timelineCount: document.getElementById('timeline-count') as HTMLElement,
      toastContainer: document.getElementById('toast-container') as HTMLElement
    };

    // ─── Initialization ───
    function init() {
      // Populate Country dropdown
      COUNTRIES.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.code;
        opt.textContent = `${c.name} (${c.limit.toFixed(2)}%)`;
        elements.countrySelect.appendChild(opt);
      });
      elements.countrySelect.value = userState.countryCode;

      // Sync emergency country select
      const emergencySelect = document.getElementById('emergency-country-select') as HTMLSelectElement | null;
      if (emergencySelect) {
        emergencySelect.value = userState.countryCode;
        emergencySelect.dispatchEvent(new Event('change'));
      }

      // Select volume unit ML, weight unit KG, height unit CM as initial styling
      setActiveUnitButton(elements.btnVolMl, elements.btnVolOz);
      setActiveUnitButton(elements.btnKg, elements.btnLbs);
      setActiveUnitButton(elements.btnCm, elements.btnIn);

      // Attach event listeners
      setupListeners();

      // Initial view layout (Profile tab active first on mobile, results locked)
      setStepSelection(1);
      updateAll();

      // Entrance animation for Step 1 on load
      (animate as any)(elements.colProfile, { opacity: [0, 1], y: [20, 0] }, { duration: 0.6, easing: [0.16, 1, 0.3, 1] });
    }

    // Helper: Manage button toggle styling in Vercel design
    function setActiveGenderButton(activeBtn: HTMLButtonElement) {
      [elements.btnMale, elements.btnFemale, elements.btnOther].forEach(btn => {
        btn.className = "py-1.5 text-xs font-medium rounded-xs text-body hover:text-ink border border-transparent transition-vercel focus:outline-none focus-visible:ring-0 focus-visible:outline-none";
      });
      activeBtn.className = "py-1.5 text-xs font-medium rounded-xs text-primary bg-canvas shadow-vercel-2 border border-hairline/20 transition-vercel focus:outline-none focus-visible:ring-0 focus-visible:outline-none";
    }

    function setActiveUnitButton(activeBtn: HTMLButtonElement, inactiveBtn: HTMLButtonElement) {
      activeBtn.className = "px-2 py-0.5 text-[10px] font-semibold font-mono rounded-xs text-primary bg-canvas shadow-vercel-1 border border-hairline/10 focus:outline-none";
      inactiveBtn.className = "px-2 py-0.5 text-[10px] font-semibold font-mono rounded-xs text-body hover:text-ink focus:outline-none";
    }

    // Set wizard active step indices and mobile/desktop lane tab toggles
    function setStepSelection(stepNum: number) {
      // 1. Manage tab display lanes (hide inactive, show active, centered, with custom widths)
      if (stepNum === 1) {
        elements.colProfile.className = "w-full max-w-xl mx-auto flex flex-col gap-6 block";
        elements.colLog.className = "w-full max-w-5xl mx-auto flex flex-col gap-6 relative min-h-[500px] hidden";
        elements.colResults.className = "w-full max-w-5xl mx-auto flex flex-col gap-6 relative min-h-[500px] hidden";

        (animate as any)(elements.colProfile, { opacity: [0, 1], y: [15, 0] }, { duration: 0.35, easing: [0.16, 1, 0.3, 1] });
      } else if (stepNum === 2) {
        // Only allow switching to step 2 if log is unlocked
        if (!logUnlocked) {
          showToast('Please click "Next: Log Drinks" in Step 1 to unlock drink logging.');
          return;
        }
        elements.colProfile.className = "w-full max-w-xl mx-auto flex flex-col gap-6 hidden";
        elements.colLog.className = "w-full max-w-5xl mx-auto flex flex-col gap-6 relative min-h-[500px] block";
        elements.colResults.className = "w-full max-w-5xl mx-auto flex flex-col gap-6 relative min-h-[500px] hidden";

        (animate as any)(elements.colLog, { opacity: [0, 1], y: [15, 0] }, { duration: 0.35, easing: [0.16, 1, 0.3, 1] });
      } else if (stepNum === 3) {
        // Only allow switching to step 3 if results are unlocked
        if (!resultsUnlocked) {
          showToast('Please click "Show BAC Results" in Step 2 to view analytics.');
          return;
        }
        elements.colProfile.className = "w-full max-w-xl mx-auto flex flex-col gap-6 hidden";
        elements.colLog.className = "w-full max-w-5xl mx-auto flex flex-col gap-6 relative min-h-[500px] hidden";
        elements.colResults.className = "w-full max-w-5xl mx-auto flex flex-col gap-6 relative min-h-[500px] block";

        (animate as any)(elements.colResults, { opacity: [0, 1], y: [15, 0] }, { duration: 0.35, easing: [0.16, 1, 0.3, 1] });

        // Force chart redraw after tab becomes visible (to calculate correct clientWidth)
        setTimeout(() => {
          if (loggedDrinks.length > 0) {
            recalculateAndUpdateDashboard();
          }
        }, 50);
      }

      // 2. Stepper Visual styling
      // Reset all
      [elements.stepNum1, elements.stepNum2, elements.stepNum3].forEach(n => {
        n.className = "w-7 h-7 rounded-full bg-canvas border border-hairline text-body text-xs font-semibold flex items-center justify-center transition-vercel";
      });
      [elements.stepTxt1, elements.stepTxt2, elements.stepTxt3].forEach(t => {
        t.className = "text-xs font-medium text-body";
      });
      elements.stepLine1.className = "flex-grow h-px bg-hairline mx-2";
      elements.stepLine2.className = "flex-grow h-px bg-hairline mx-2";

      elements.tabProfile.setAttribute('aria-selected', stepNum === 1 ? 'true' : 'false');
      elements.tabLog.setAttribute('aria-selected', stepNum === 2 ? 'true' : 'false');
      elements.tabResults.setAttribute('aria-selected', stepNum === 3 ? 'true' : 'false');

      // Highlight active step state
      if (stepNum === 1) {
        elements.stepNum1.className = "w-7 h-7 rounded-full bg-primary text-canvas-soft text-xs font-semibold flex items-center justify-center transition-vercel";
        elements.stepTxt1.className = "text-xs font-semibold text-primary";
      } else if (stepNum === 2) {
        elements.stepNum1.className = "w-7 h-7 rounded-full bg-primary/20 text-primary text-xs font-semibold flex items-center justify-center transition-vercel";
        elements.stepNum2.className = "w-7 h-7 rounded-full bg-primary text-canvas-soft text-xs font-semibold flex items-center justify-center transition-vercel";
        elements.stepTxt2.className = "text-xs font-semibold text-primary";
        elements.stepLine1.className = "flex-grow h-px bg-hairline-strong mx-2";
      } else if (stepNum === 3) {
        elements.stepNum1.className = "w-7 h-7 rounded-full bg-primary/20 text-primary text-xs font-semibold flex items-center justify-center transition-vercel";
        elements.stepNum2.className = "w-7 h-7 rounded-full bg-primary/20 text-primary text-xs font-semibold flex items-center justify-center transition-vercel";
        elements.stepNum3.className = "w-7 h-7 rounded-full bg-primary text-canvas-soft text-xs font-semibold flex items-center justify-center transition-vercel";
        elements.stepTxt3.className = "text-xs font-semibold text-primary";
        elements.stepLine1.className = "flex-grow h-px bg-hairline-strong mx-2";
        elements.stepLine2.className = "flex-grow h-px bg-hairline-strong mx-2";
      }
    }

    // ─── Event Listeners ───
    function setupListeners() {
      // Stepper Tab Button Clicks
      elements.tabProfile.addEventListener('click', () => setStepSelection(1));
      elements.tabLog.addEventListener('click', () => setStepSelection(2));
      elements.tabResults.addEventListener('click', () => setStepSelection(3));

      // Onboarding step progression CTAs
      elements.btnToStep2.addEventListener('click', () => {
        unlockStep2();
        setStepSelection(2);
      });
      
      // Dialog modal toggling (Show Results button)
      elements.btnToStep3.addEventListener('click', () => {
        if (loggedDrinks.length === 0) {
          showToast('Please add at least one drink to calculate BAC.');
          return;
        }
        calculateAndOpenModal();
      });

      // Modal close click handlers
      elements.btnCloseModal.addEventListener('click', closeModal);
      elements.btnCloseModalBottom.addEventListener('click', closeModal);
      
      // Close modal on outside click (Vercel UX design alignment)
      elements.resultsModal.addEventListener('click', (e) => {
        if (e.target === elements.resultsModal) {
          closeModal();
        }
      });

      // Keyboard Esc key close configuration
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !elements.resultsModal.classList.contains('hidden')) {
          closeModal();
        }
      });

      // Gender Toggles
      elements.btnMale.addEventListener('click', () => { userState.gender = 'male'; setActiveGenderButton(elements.btnMale); updateAll(); });
      elements.btnFemale.addEventListener('click', () => { userState.gender = 'female'; setActiveGenderButton(elements.btnFemale); updateAll(); });
      elements.btnOther.addEventListener('click', () => { userState.gender = 'other'; setActiveGenderButton(elements.btnOther); updateAll(); });

      // Age Inputs (sync range slider & numerical input)
      elements.ageSlider.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        elements.ageInput.value = target.value;
        elements.ageLbl.textContent = target.value;
        userState.age = parseInt(target.value, 10);
        updateAll();
      });
      elements.ageInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        let val = parseInt(target.value, 10);
        if (isNaN(val)) val = 16;
        if (val < 16) val = 16;
        if (val > 90) val = 90;
        elements.ageSlider.value = val.toString();
        elements.ageLbl.textContent = val.toString();
        userState.age = val;
        updateAll();
      });

      // Weight Units Toggle
      elements.btnKg.addEventListener('click', () => {
        if (userState.weightUnit === 'lbs') {
          userState.weightUnit = 'kg';
          setActiveUnitButton(elements.btnKg, elements.btnLbs);
          elements.weightUnitLbl.textContent = 'kg';
          let currentVal = parseFloat(elements.weightInput.value);
          elements.weightInput.value = Math.round(currentVal * 0.453592).toString();
          userState.weight = parseInt(elements.weightInput.value, 10);
          updateAll();
        }
      });
      elements.btnLbs.addEventListener('click', () => {
        if (userState.weightUnit === 'kg') {
          userState.weightUnit = 'lbs';
          setActiveUnitButton(elements.btnLbs, elements.btnKg);
          elements.weightUnitLbl.textContent = 'lbs';
          let currentVal = parseFloat(elements.weightInput.value);
          elements.weightInput.value = Math.round(currentVal / 0.453592).toString();
          userState.weight = parseInt(elements.weightInput.value, 10);
          updateAll();
        }
      });
      elements.weightInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        let val = parseFloat(target.value);
        if (isNaN(val)) val = 70;
        userState.weight = val;
        updateAll();
      });

      // Height Units Toggle
      elements.btnCm.addEventListener('click', () => {
        if (userState.heightUnit === 'in') {
          userState.heightUnit = 'cm';
          setActiveUnitButton(elements.btnCm, elements.btnIn);
          elements.heightUnitLbl.textContent = 'cm';
          let currentVal = parseFloat(elements.heightInput.value);
          elements.heightInput.value = Math.round(currentVal * 2.54).toString();
          userState.height = parseInt(elements.heightInput.value, 10);
          updateAll();
        }
      });
      elements.btnIn.addEventListener('click', () => {
        if (userState.heightUnit === 'cm') {
          userState.heightUnit = 'in';
          setActiveUnitButton(elements.btnIn, elements.btnCm);
          elements.heightUnitLbl.textContent = 'in';
          let currentVal = parseFloat(elements.heightInput.value);
          elements.heightInput.value = Math.round(currentVal / 2.54).toString();
          userState.height = parseInt(elements.heightInput.value, 10);
          updateAll();
        }
      });
      elements.heightInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        let val = parseFloat(target.value);
        if (isNaN(val)) val = 170;
        userState.height = val;
        updateAll();
      });

      // Country Select
      elements.countrySelect.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        userState.countryCode = target.value;
        const country = COUNTRIES.find(c => c.code === userState.countryCode);
        if (country) {
          elements.countryWarningText.innerHTML = `${country.name} legal limit is <span class="font-mono font-semibold">${country.limit.toFixed(2)}%</span> BAC. ${country.note}`;
        }
        
        // Update the active drink presets for the new country
        const activeCatBtn = document.querySelector('[data-preset-cat].bg-primary');
        const cat = activeCatBtn ? activeCatBtn.getAttribute('data-preset-cat') || 'beer' : 'beer';
        
        // Re-render sub-presets
        renderSubPresets(cat);
        
        // Update input fields to default values for this country's category
        updateDrinkInputsToPresetDefaults(cat);
        
        syncActivePills();
        updateImpactPreview();
        updateAll();

        // Sync with emergency country select if it exists
        const emergencySelect = document.getElementById('emergency-country-select') as HTMLSelectElement | null;
        if (emergencySelect && emergencySelect.value !== target.value) {
          emergencySelect.value = target.value;
          emergencySelect.dispatchEvent(new Event('change'));
        }
      });

      // Drink select dropdown change handler
      elements.drinkSelect.addEventListener('change', populateFormFromSelection);

      // Drink volume units toggle
      elements.btnVolMl.addEventListener('click', () => {
        if (elements.drinkVolumeUnit.textContent === 'oz') {
          setActiveUnitButton(elements.btnVolMl, elements.btnVolOz);
          elements.drinkVolumeUnit.textContent = 'ml';
          let currentVal = parseFloat(elements.drinkVolume.value);
          elements.drinkVolume.value = Math.round(currentVal * 29.5735).toString();
          syncActivePills();
          updateImpactPreview();
        }
      });
      elements.btnVolOz.addEventListener('click', () => {
        if (elements.drinkVolumeUnit.textContent === 'ml') {
          setActiveUnitButton(elements.btnVolOz, elements.btnVolMl);
          elements.drinkVolumeUnit.textContent = 'oz';
          let currentVal = parseFloat(elements.drinkVolume.value);
          elements.drinkVolume.value = (currentVal / 29.5735).toFixed(1);
          syncActivePills();
          updateImpactPreview();
        }
      });

      // Drink ABV slider sync
      elements.abvSlider.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        elements.abvInput.value = target.value;
        elements.abvLbl.textContent = parseFloat(target.value).toFixed(1);
      });
      elements.abvInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        let val = parseFloat(target.value);
        if (isNaN(val)) val = 5.0;
        if (val < 0.1) val = 0.1;
        if (val > 100.0) val = 100.0;
        elements.abvSlider.value = val.toString();
        elements.abvLbl.textContent = val.toFixed(1);
      });

      // Drink time ago slider label updating
      elements.timeAgoSlider.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        let mins = parseInt(target.value, 10);
        if (mins === 0) {
          elements.timeAgoLbl.textContent = 'Just now';
        } else if (mins < 60) {
          elements.timeAgoLbl.textContent = `${mins} mins ago`;
        } else {
          let hrs = Math.floor(mins / 60);
          let remMins = mins % 60;
          elements.timeAgoLbl.textContent = remMins === 0 ? `${hrs}h ago` : `${hrs}h ${remMins}m ago`;
        }
      });

      // Add Drink Event
      elements.btnAdd.addEventListener('click', addDrinkFromForm);

      // Clear Timeline Event
      elements.btnClear.addEventListener('click', () => {
        loggedDrinks = [];
        drinkCount = 1;
        
        // Relock Step 3 (Results) on clear
        resultsUnlocked = false;
        elements.resultsLockOverlay.classList.remove('pointer-events-none', 'hidden');
        elements.resultsLockOverlay.style.opacity = "";
        elements.resultsLockOverlay.style.transform = "";
        elements.resultsDashboardContent.className = "flex flex-col flex-grow gap-6 opacity-30 pointer-events-none transition-vercel select-none";

        // Reset dynamic readouts and SVG chart paths to sober baselines
        const country = COUNTRIES.find(c => c.code === userState.countryCode);
        const limit = country ? country.limit : 0.05;
        const countryName = country ? country.name : "United States";
        
        updateUIContainer('out-', 0, 0, limit, null, null, 0, [], 0, countryName, false);
        updateUIContainer('modal-', 0, 0, limit, null, null, 0, [], 0, countryName, false);
        
        updateAll();

        // Auto navigate back to Step 1
        setStepSelection(1);
        
        showToast('Drinking log cleared and reset successfully.');
      });

      // Global Emergency Contacts Interactivity
      const emergencySelect = document.getElementById('emergency-country-select') as HTMLSelectElement | null;
      const emergencyInfo = document.getElementById('emergency-numbers-info');
      const emergencyPrimaryBox = document.getElementById('emergency-primary-box');
      const emergencyPrimaryLink = document.getElementById('emergency-primary-link') as HTMLAnchorElement | null;
      const emergencyPoliceCol = document.getElementById('emergency-police-col');
      const emergencyPoliceLink = document.getElementById('emergency-police-link') as HTMLAnchorElement | null;
      const emergencyAmbulanceCol = document.getElementById('emergency-ambulance-col');
      const emergencyAmbulanceLink = document.getElementById('emergency-ambulance-link') as HTMLAnchorElement | null;
      const emergencyFireCol = document.getElementById('emergency-fire-col');
      const emergencyFireLink = document.getElementById('emergency-fire-link') as HTMLAnchorElement | null;
      const emergency112Note = document.getElementById('emergency-112-note');

      emergencySelect?.addEventListener('change', () => {
        const code = emergencySelect.value;
        const country = emergencyNumbers.find(c => c.code === code);
        if (!country || !emergencyInfo) return;

        // Show the main display box
        emergencyInfo.classList.remove('hidden');

        // Primary General number
        if (country.primary && emergencyPrimaryBox && emergencyPrimaryLink) {
          emergencyPrimaryBox.classList.remove('hidden');
          emergencyPrimaryLink.textContent = country.primary;
          emergencyPrimaryLink.href = `tel:${country.primary}`;
        } else if (emergencyPrimaryBox) {
          emergencyPrimaryBox.classList.add('hidden');
        }

        // Police number
        if (country.police && emergencyPoliceCol && emergencyPoliceLink) {
          emergencyPoliceCol.classList.remove('hidden');
          emergencyPoliceLink.textContent = country.police;
          emergencyPoliceLink.href = `tel:${country.police}`;
        } else if (emergencyPoliceCol) {
          emergencyPoliceCol.classList.add('hidden');
        }

        // Ambulance number
        if (country.ambulance && emergencyAmbulanceCol && emergencyAmbulanceLink) {
          emergencyAmbulanceCol.classList.remove('hidden');
          emergencyAmbulanceLink.textContent = country.ambulance;
          emergencyAmbulanceLink.href = `tel:${country.ambulance}`;
        } else if (emergencyAmbulanceCol) {
          emergencyAmbulanceCol.classList.add('hidden');
        }

        // Fire number
        if (country.fire && emergencyFireCol && emergencyFireLink) {
          emergencyFireCol.classList.remove('hidden');
          emergencyFireLink.textContent = country.fire;
          emergencyFireLink.href = `tel:${country.fire}`;
        } else if (emergencyFireCol) {
          emergencyFireCol.classList.add('hidden');
        }

        // 112 support note
        if (country.member112 && emergency112Note) {
          emergency112Note.classList.remove('hidden');
        } else if (emergency112Note) {
          emergency112Note.classList.add('hidden');
        }
      });

      // Initialize Visual Preset Grid & Quick Pills
      setupPresets();
    }

    // Populate the drink input form fields on dropdown select change
    function populateFormFromSelection() {
      const selectedOpt = elements.drinkSelect.options[elements.drinkSelect.selectedIndex];
      if (!selectedOpt) return;
      
      const valType = selectedOpt.value;
      const name = selectedOpt.getAttribute('data-name') || "";
      const volMl = parseFloat(selectedOpt.getAttribute('data-vol') || "0");
      const abv = parseFloat(selectedOpt.getAttribute('data-abv') || "0");
      
      // Update Name & toggle custom container visibility
      if (valType === 'custom') {
        elements.customLabelContainer.classList.remove('hidden');
        elements.drinkName.value = "Custom Drink";
        elements.drinkName.focus();
      } else {
        elements.customLabelContainer.classList.add('hidden');
        elements.drinkName.value = name;
      }
      
      // Update Volume (convert to OZ if currently selected unit is oz)
      const isOz = elements.drinkVolumeUnit.textContent === 'oz';
      if (isOz) {
        elements.drinkVolume.value = (volMl / 29.5735).toFixed(1);
      } else {
        elements.drinkVolume.value = volMl.toString();
      }
      
      // Update ABV
      elements.abvInput.value = abv.toString();
      elements.abvSlider.value = abv.toString();
      elements.abvLbl.textContent = abv.toFixed(1);
      
      // Highlight the active category card
      let cat = 'custom';
      if (valType.startsWith('beer')) cat = 'beer';
      else if (valType.startsWith('wine')) cat = 'wine';
      else if (valType.startsWith('shot')) cat = 'shot';
      else if (valType.startsWith('cocktail')) cat = 'cocktail';
      else if (valType === 'cider') cat = 'beer';
      
      const presetBtn = document.querySelector(`[data-preset-cat="${cat}"]`);
      if (presetBtn) {
        presetBtn.classList.add('ring-2', 'ring-link/30');
        setTimeout(() => presetBtn.classList.remove('ring-2', 'ring-link/30'), 500);
      }
    }


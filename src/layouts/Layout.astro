---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Online Alcohol Detect | Advanced BAC Calculator & Safety Guide",
  description = "Estimate your Blood Alcohol Concentration (BAC) using the scientifically refined Watson formula. Track drinks over time, check driving limits by country, and view real-time countdowns to sobriety."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://www.alcoholdetect.com');
const ogImageURL = new URL('/og-image.png', 'https://www.alcoholdetect.com');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" href="/icon.png?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/icon.png?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    
    <!-- Preload Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Blocking script to prevent flash of light/dark theme -->
    <script is:inline>
      (() => {
        const theme = localStorage.getItem('theme') || 'system';
        if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E0W8P7Y27K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-E0W8P7Y27K');
    </script>
    
    <!-- JSON-LD Structured Data Schema Markup -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Online Alcohol Detect BAC Calculator",
        "url": "https://www.alcoholdetect.com",
        "applicationCategory": "HealthApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires JavaScript. Requires HTML5.",
        "description": "Estimate Blood Alcohol Content (BAC) using Watson's Total Body Water equations. Track drink timelines and calculate sobriety time.",
        "offers": {
          "@type": "Offer",
          "price": "0.00",
          "priceCurrency": "USD"
        }
      }
    </script>
  </head>
  <body class="bg-canvas-soft text-ink min-h-screen flex flex-col antialiased selection:bg-primary selection:text-canvas-soft">
    
    <!-- Announcement Banner -->
    <div class="bg-primary text-canvas-soft text-center py-2 px-4 text-xs font-mono tracking-wide">
      ⚠️ SAFETY NOTE: Calculator estimates only. Never drink and drive.
    </div>

    <!-- Sticky Navigation Bar -->
    <header class="sticky top-0 z-50 bg-canvas/80 backdrop-blur-md border-b border-hairline h-16 flex items-center transition-vercel">
      <div class="max-w-7xl w-full mx-auto px-4 md:px-6 flex items-center justify-between relative">
        
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 focus-visible:outline-none" id="nav-logo-link">
          <img src="/icon.png" alt="Online Alcohol Detect Logo" class="h-6 w-6 object-contain rounded-xs" />
          <span class="font-sans font-semibold tracking-[-0.6px] text-lg text-primary flex items-center gap-1.5">
            alcoholdetect<span class="text-xs font-mono font-normal bg-canvas-soft px-1.5 py-0.5 rounded-sm border border-hairline text-body hidden sm:inline-block">v1.0</span>
          </span>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-1.5">
          <a href="/#calculator" class="text-body hover:text-ink text-sm font-medium px-3 py-1.5 rounded-pill hover:bg-canvas-soft transition-vercel" id="nav-calc">BAC Calculator</a>
          <a href="/#country-limits" class="text-body hover:text-ink text-sm font-medium px-3 py-1.5 rounded-pill hover:bg-canvas-soft transition-vercel" id="nav-limits">Legal Driving Limits</a>
          <a href="/#science" class="text-body hover:text-ink text-sm font-medium px-3 py-1.5 rounded-pill hover:bg-canvas-soft transition-vercel" id="nav-science">Science & Math</a>
          <a href="/#disclaimer" class="text-body hover:text-ink text-sm font-medium px-3 py-1.5 rounded-pill hover:bg-canvas-soft transition-vercel" id="nav-disclaimer">Disclaimer Notice</a>
        </nav>

        <!-- Right Action Cluster -->
        <div class="flex items-center gap-3">
          <a href="/#emergency" class="hidden sm:inline-flex items-center justify-center text-xs font-mono font-medium border border-hairline bg-canvas hover:bg-canvas-soft text-primary px-3 h-8 rounded-sm transition-vercel focus-visible:outline-none" id="nav-emergency-btn">
            Emergency Helplines
          </a>
          <a href="/#calculator" class="hidden sm:inline-flex items-center justify-center text-xs font-semibold bg-primary hover:bg-primary/90 text-canvas-soft px-3.5 h-8 rounded-pill transition-vercel focus-visible:outline-none" id="nav-start-btn">
            BAC Estimator Tool
          </a>

          <!-- Mobile Theme Toggle (Single Button) -->
          <button type="button" class="md:hidden flex items-center justify-center w-8 h-8 rounded-full border border-hairline bg-canvas-soft hover:bg-canvas text-mute hover:text-ink focus:outline-none transition-colors cursor-pointer" id="mobile-theme-toggle" aria-label="Toggle Theme">
            <svg class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5" />
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
            </svg>
            <svg class="h-4 w-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>

          <!-- Vercel-style Segmented Theme Selector -->
          <div class="hidden md:flex relative items-center bg-canvas-soft-2 border border-hairline p-0.5 rounded-full" id="theme-selector-group">
            <!-- Sliding Active Background indicator -->
            <span class="absolute top-0.5 bottom-0.5 rounded-full bg-canvas shadow-vercel-2 pointer-events-none" id="theme-indicator"></span>
            
            <!-- Light Mode Button -->
            <button type="button" class="relative z-10 flex items-center justify-center w-8 h-8 rounded-full text-mute hover:text-ink focus:outline-none transition-colors cursor-pointer" data-theme-value="light" aria-label="Light Theme">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
              </svg>
            </button>

            <!-- System Preference Button -->
            <button type="button" class="relative z-10 flex items-center justify-center w-8 h-8 rounded-full text-mute hover:text-ink focus:outline-none transition-colors cursor-pointer" data-theme-value="system" aria-label="System Theme">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" />
                <line x1="8" y1="21" x2="16" y2="21" />
                <line x1="12" y1="17" x2="12" y2="21" />
              </svg>
            </button>

            <!-- Dark Mode Button -->
            <button type="button" class="relative z-10 flex items-center justify-center w-8 h-8 rounded-full text-mute hover:text-ink focus:outline-none transition-colors cursor-pointer" data-theme-value="dark" aria-label="Dark Theme">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3a9 9 0 1 0 9 9 9.75 9.75 0 0 0-.674-3.474 6 6 0 0 1-8.252-8.252A9.75 9.75 0 0 0 12 3z" />
              </svg>
            </button>
          </div>
          
          <!-- Mobile Menu Toggle -->
          <button class="md:hidden p-1.5 text-body hover:text-ink focus-visible:outline-none" id="mobile-menu-toggle" aria-label="Toggle Menu">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

        <!-- Mobile Dropdown Bubble Menu (hidden/positioned absolutely under the header) -->
        <div id="mobile-nav-menu" class="absolute top-14 right-4 z-40 w-56 bg-canvas border border-hairline rounded-lg p-4 flex flex-col gap-2.5 shadow-vercel-4 md:hidden transition-vercel transform opacity-0 pointer-events-none origin-top-right scale-95">
          <a href="/#calculator" class="text-primary hover:text-link text-sm font-medium py-1.5 transition-vercel focus-visible:outline-none" id="mobile-nav-calc">BAC Calculator</a>
          <a href="/#country-limits" class="text-primary hover:text-link text-sm font-medium py-1.5 transition-vercel focus-visible:outline-none" id="mobile-nav-limits">Legal Driving Limits</a>
          <a href="/#science" class="text-primary hover:text-link text-sm font-medium py-1.5 transition-vercel focus-visible:outline-none" id="mobile-nav-science">Science & Math</a>
          <a href="/#disclaimer" class="text-primary hover:text-link text-sm font-medium py-1.5 transition-vercel focus-visible:outline-none" id="mobile-nav-disclaimer">Disclaimer Notice</a>
          <div class="border-t border-hairline my-1"></div>
          <a href="/#emergency" class="text-xs font-mono font-medium border border-hairline bg-canvas-soft hover:bg-canvas text-primary px-3 py-2 rounded-sm text-center transition-vercel focus-visible:outline-none" id="mobile-nav-emergency">Emergency Helplines</a>
        </div>

      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Vercel-style 4-column Footer -->
    <footer class="bg-canvas border-t border-hairline pt-16 pb-12 transition-vercel">
      <div class="max-w-7xl mx-auto px-4 md:px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
          
          <!-- Column 1 -->
          <div>
            <h3 class="font-mono text-[11px] font-semibold text-mute uppercase tracking-widest mb-4">Calculator</h3>
            <ul class="space-y-3">
              <li><a href="/#calculator" class="text-body hover:text-ink text-sm transition-vercel">Estimator Dashboard</a></li>
              <li><a href="/#calculator" class="text-body hover:text-ink text-sm transition-vercel">Drink Log Timeline</a></li>
              <li><a href="/#country-limits" class="text-body hover:text-ink text-sm transition-vercel">Global Driving Limits</a></li>
              <li><a href="/#science" class="text-body hover:text-ink text-sm transition-vercel">Watson Formula Math</a></li>
            </ul>
          </div>

          <!-- Column 2 -->
          <div>
            <h3 class="font-mono text-[11px] font-semibold text-mute uppercase tracking-widest mb-4">Resources</h3>
            <ul class="space-y-3">
              <li><a href="/#science" class="text-body hover:text-ink text-sm transition-vercel">Metabolism Science</a></li>
              <li><a href="/#emergency" class="text-body hover:text-ink text-sm transition-vercel">Helpline Directory</a></li>
              <li><a href="https://www.who.int" target="_blank" rel="noopener noreferrer" class="text-body hover:text-ink text-sm transition-vercel">WHO Guidelines ↗</a></li>
              <li><a href="https://www.nhtsa.gov" target="_blank" rel="noopener noreferrer" class="text-body hover:text-ink text-sm transition-vercel">NHTSA Regulations ↗</a></li>
            </ul>
          </div>

          <!-- Column 3 -->
          <div>
            <h3 class="font-mono text-[11px] font-semibold text-mute uppercase tracking-widest mb-4">Legal</h3>
            <ul class="space-y-3">
              <li><a href="/#disclaimer" class="text-body hover:text-ink text-sm transition-vercel">Safety Disclaimer</a></li>
              <li><a href="/terms" class="text-body hover:text-ink text-sm transition-vercel">Terms & Conditions</a></li>
              <li><a href="/privacy" class="text-body hover:text-ink text-sm transition-vercel">Privacy Policy</a></li>
              <li><a href="#" class="text-body hover:text-ink text-sm transition-vercel">Cookie Settings</a></li>
            </ul>
          </div>

          <!-- Column 4 -->
          <div>
            <h3 class="font-mono text-[11px] font-semibold text-mute uppercase tracking-widest mb-4">About</h3>
            <ul class="space-y-3">
              <li><a href="/about" class="text-body hover:text-ink text-sm transition-vercel">About Us</a></li>
              <li><a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-body hover:text-ink text-sm transition-vercel">Open Source ↗</a></li>
              <li><a href="/contact" class="text-body hover:text-ink text-sm transition-vercel">Contact Support</a></li>
              <li><a href="#" class="text-body hover:text-ink text-sm transition-vercel">Developer Portal</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-hairline pt-8 flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex items-center gap-3">
            <img src="/icon.png" alt="Online Alcohol Detect Logo" class="h-5 w-5 object-contain opacity-80" />
            <p class="text-mute text-xs font-mono">
              © {new Date().getFullYear()} online alcohol detect. All rights reserved.
            </p>
          </div>
          <p class="text-mute text-xs max-w-md text-center md:text-right font-sans">
            Disclaimer: The results provided by this calculator are estimates for informational purposes only. Do not rely on them to decide if you are fit to drive.
          </p>
        </div>
      </div>
    </footer>

    <!-- Interactive navigation scripting -->
    <script>
      const menuToggle = document.getElementById('mobile-menu-toggle');
      const menu = document.getElementById('mobile-nav-menu');
      
      const menuLinks = [
        document.getElementById('mobile-nav-calc'),
        document.getElementById('mobile-nav-limits'),
        document.getElementById('mobile-nav-science'),
        document.getElementById('mobile-nav-disclaimer'),
        document.getElementById('mobile-nav-emergency')
      ];

      let isOpen = false;

      function openMenu() {
        isOpen = true;
        menu?.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
        menu?.classList.add('opacity-100', 'scale-100');
      }

      function closeMenu() {
        isOpen = false;
        menu?.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
        menu?.classList.remove('opacity-100', 'scale-100');
      }

      menuToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      menuLinks.forEach(link => {
        link?.addEventListener('click', closeMenu);
      });

      // Close menu if user clicks anywhere outside of the menu
      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (isOpen && menu && target && !menu.contains(target) && target !== menuToggle && (!menuToggle || !menuToggle.contains(target))) {
          closeMenu();
        }
      });

      // Theme selector group handler
      const themeSelector = document.getElementById('theme-selector-group');
      const themeButtons = themeSelector ? themeSelector.querySelectorAll('[data-theme-value]') : [];
      const themeIndicator = document.getElementById('theme-indicator');

      let activeTheme = localStorage.getItem('theme') || 'system';

      function applyTheme(theme: string) {
        if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        
        // Dispatch theme-change event for reactive parts (like charts)
        window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme } }));
      }

      function updateSelectorUI(theme: string) {
        themeButtons.forEach(button => {
          const isSelected = button.getAttribute('data-theme-value') === theme;
          if (isSelected) {
            button.classList.add('text-ink');
            button.classList.remove('text-mute');
            
            // Position sliding indicator
            if (themeIndicator && themeSelector) {
              themeIndicator.style.left = `${(button as HTMLElement).offsetLeft}px`;
              themeIndicator.style.width = `${(button as HTMLElement).offsetWidth}px`;
            }
          } else {
            button.classList.remove('text-ink');
            button.classList.add('text-mute');
          }
        });
      }

      // Add click listeners to buttons
      themeButtons.forEach(button => {
        button.addEventListener('click', () => {
          const theme = button.getAttribute('data-theme-value') || 'system';
          activeTheme = theme;
          localStorage.setItem('theme', theme);
          applyTheme(theme);
          updateSelectorUI(theme);
        });
      });

      // Listen for system theme changes
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (activeTheme === 'system') {
          applyTheme('system');
        }
      });

      // Initial layout sync
      updateSelectorUI(activeTheme);
      
      // Enable transitions after a frame to prevent slide-in on load
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          themeIndicator?.classList.add('transition-all', 'duration-200', 'ease-in-out');
        });
      });

      // Mobile theme toggle click handler
      const mobileThemeToggle = document.getElementById('mobile-theme-toggle');
      if (mobileThemeToggle) {
        mobileThemeToggle.addEventListener('click', () => {
          const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
          const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
          activeTheme = newTheme;
          localStorage.setItem('theme', newTheme);
          applyTheme(newTheme);
          updateSelectorUI(newTheme);
        });
      }

      // Reposition on resize and load to ensure accurate client dimensions
      window.addEventListener('resize', () => updateSelectorUI(activeTheme));
      window.addEventListener('load', () => updateSelectorUI(activeTheme));
    </script>
  </body>
</html>

    function updateDrinkInputsToPresetDefaults(cat: string) {
      if (cat === 'custom') {
        elements.customLabelContainer.classList.remove('hidden');
        elements.drinkName.value = "Custom Drink";
        return;
      }
      
      elements.customLabelContainer.classList.add('hidden');
      
      let prettyName = cat.charAt(0).toUpperCase() + cat.slice(1);
      if (prettyName === 'Shot') prettyName = 'Liquor/Shot';
      elements.drinkName.value = prettyName;
      
      const presets = getCategoryPresetsForCountry(userState.countryCode);
      const preset = presets[cat];
      if (preset) {
        const volIdx = preset.defaultVolIndex;
        const abvIdx = preset.defaultAbvIndex;
        
        const v = preset.volumes[volIdx] || preset.volumes[0];
        const a = preset.abvs[abvIdx] || preset.abvs[0];
        
        if (v) {
          const isOz = elements.drinkVolumeUnit.textContent === 'oz';
          if (isOz) {
            elements.drinkVolume.value = (v.ml / 29.5735).toFixed(1);
          } else {
            elements.drinkVolume.value = v.ml.toString();
          }
        }
        
        if (a) {
          elements.abvInput.value = a.val.toString();
          elements.abvSlider.value = a.val.toString();
          elements.abvLbl.textContent = a.val.toFixed(1);
        }
      }
    }

    function renderSubPresets(cat: string) {
      const volContainer = document.getElementById('sub-presets-volume');
      const abvContainer = document.getElementById('sub-presets-abv');
      const volList = document.getElementById('volume-pills-list');
      const abvList = document.getElementById('abv-pills-list');
      
      if (!volContainer || !abvContainer || !volList || !abvList) return;
      
      const presets = getCategoryPresetsForCountry(userState.countryCode);
      
      if (cat === 'custom' || !presets[cat]) {
        volContainer.classList.add('hidden');
        abvContainer.classList.add('hidden');
        return;
      }
      
      volContainer.classList.remove('hidden');
      abvContainer.classList.remove('hidden');
      
      const preset = presets[cat];
      
      // Render volume pills
      volList.innerHTML = '';
      preset.volumes.forEach((v) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'px-2.5 py-1 text-[11px] font-medium rounded-xs border border-hairline bg-canvas text-body hover:text-ink transition-vercel focus:outline-none cursor-pointer';
        btn.textContent = v.label;
        btn.setAttribute('data-ml', v.ml.toString());
        
        btn.addEventListener('click', () => {
          const isOz = elements.drinkVolumeUnit.textContent === 'oz';
          if (isOz) {
            elements.drinkVolume.value = (v.ml / 29.5735).toFixed(1);
          } else {
            elements.drinkVolume.value = v.ml.toString();
          }
          
          syncActivePills();
          updateImpactPreview();
          
          // Flash volume input container to show update
          const parent = elements.drinkVolume.parentElement;
          if (parent) {
            parent.classList.add('ring-2', 'ring-link/30');
            setTimeout(() => parent.classList.remove('ring-2', 'ring-link/30'), 400);
          }
        });
        
        volList.appendChild(btn);
      });
      
      // Render ABV pills
      abvList.innerHTML = '';
      preset.abvs.forEach((a) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'px-2.5 py-1 text-[11px] font-medium rounded-xs border border-hairline bg-canvas text-body hover:text-ink transition-vercel focus:outline-none cursor-pointer';
        btn.textContent = a.label;
        btn.setAttribute('data-abv', a.val.toString());
        
        btn.addEventListener('click', () => {
          elements.abvInput.value = a.val.toString();
          elements.abvSlider.value = a.val.toString();
          elements.abvLbl.textContent = a.val.toFixed(1);
          
          syncActivePills();
          updateImpactPreview();
          
          // Flash ABV slider container to show update
          const parent = elements.abvSlider.parentElement;
          if (parent) {
            parent.classList.add('ring-2', 'ring-link/30');
            setTimeout(() => parent.classList.remove('ring-2', 'ring-link/30'), 400);
          }
        });
        
        abvList.appendChild(btn);
      });
    }

    function syncActivePills() {
      const volList = document.getElementById('volume-pills-list');
      const abvList = document.getElementById('abv-pills-list');
      
      const presets = getCategoryPresetsForCountry(userState.countryCode);
      const activeCatBtn = document.querySelector('[data-preset-cat].bg-primary');
      const cat = activeCatBtn ? activeCatBtn.getAttribute('data-preset-cat') || 'beer' : 'beer';
      
      if (volList && cat !== 'custom' && presets[cat]) {
        let currentVolMl = parseFloat(elements.drinkVolume.value);
        if (isNaN(currentVolMl)) currentVolMl = 0;
        if (elements.drinkVolumeUnit.textContent === 'oz') {
          currentVolMl = Math.round(currentVolMl * 29.5735);
        }
        
        Array.from(volList.children).forEach(btn => {
          const ml = parseFloat(btn.getAttribute('data-ml') || '0');
          if (Math.abs(ml - currentVolMl) < 5) {
            btn.className = 'px-2.5 py-1 text-[11px] font-semibold rounded-xs border border-transparent bg-primary text-canvas-soft shadow-vercel-1 transition-vercel focus:outline-none';
          } else {
            btn.className = 'px-2.5 py-1 text-[11px] font-medium rounded-xs border border-hairline bg-canvas text-body hover:text-ink transition-vercel focus:outline-none';
          }
        });
      }
      
      if (abvList && cat !== 'custom' && presets[cat]) {
        let currentAbv = parseFloat(elements.abvInput.value);
        if (isNaN(currentAbv)) currentAbv = 0;
        Array.from(abvList.children).forEach(btn => {
          const abv = parseFloat(btn.getAttribute('data-abv') || '0');
          if (Math.abs(abv - currentAbv) < 0.1) {
            btn.className = 'px-2.5 py-1 text-[11px] font-semibold rounded-xs border border-transparent bg-primary text-canvas-soft shadow-vercel-1 transition-vercel focus:outline-none';
          } else {
            btn.className = 'px-2.5 py-1 text-[11px] font-medium rounded-xs border border-hairline bg-canvas text-body hover:text-ink transition-vercel focus:outline-none';
          }
        });
      }
    }

    function updateImpactPreview() {
      const bio = getNormalizedBiology();
      const tbw = calculateTBW(bio.gender, bio.weightKg, bio.heightCm, bio.age);
      
      let vol = parseFloat(elements.drinkVolume.value);
      const abv = parseFloat(elements.abvInput.value);
      
      if (isNaN(vol) || vol <= 0 || isNaN(abv) || abv <= 0 || isNaN(tbw) || tbw <= 0) {
        const previewVal = document.getElementById('impact-preview-val');
        if (previewVal) previewVal.textContent = "+0.000% BAC · +0.0h sober";
        return;
      }
      
      if (elements.drinkVolumeUnit.textContent === 'oz') {
        vol = vol * 29.5735;
      }
      
      const pureAlcoholGrams = vol * (abv / 100) * 0.789;
      const peakBAC = (pureAlcoholGrams * 0.8) / (tbw * 10);
      const hoursToSober = peakBAC / 0.015;
      
      const previewVal = document.getElementById('impact-preview-val');
      if (previewVal) {
        previewVal.textContent = `+${peakBAC.toFixed(3)}% BAC · +${hoursToSober.toFixed(1)}h sober`;
      }
    }

    function setupPresets() {
      // 1. Category Preset Button Clicks
      const catButtons = document.querySelectorAll('[data-preset-cat]');
      catButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-preset-cat');
          if (!cat) return;
          
          // Toggle active classes on category buttons
          catButtons.forEach(b => {
            b.className = 'py-2.5 px-1 flex flex-col items-center justify-center gap-1.5 border border-hairline bg-canvas text-body hover:text-ink rounded-sm transition-vercel focus:outline-none cursor-pointer';
          });
          btn.className = 'py-2.5 px-1 flex flex-col items-center justify-center gap-1.5 border border-transparent bg-primary text-canvas-soft shadow-vercel-2 rounded-sm transition-vercel focus:outline-none cursor-pointer';
          
          // Update inputs based on preset defaults
          updateDrinkInputsToPresetDefaults(cat);
          
          // Render sub-presets
          renderSubPresets(cat);
          syncActivePills();
          updateImpactPreview();
        });
      });

      // 2. Volume and ABV manual input event listeners to sync active pills and update impact preview
      elements.drinkVolume.addEventListener('input', () => {
        syncActivePills();
        updateImpactPreview();
      });
      elements.drinkVolume.addEventListener('change', () => {
        syncActivePills();
        updateImpactPreview();
      });

      // 3. Quick Time Pill Clicks
      const timePills = document.querySelectorAll('.time-quick-btn');
      timePills.forEach(pill => {
        pill.addEventListener('click', () => {
          const timeVal = parseInt(pill.getAttribute('data-time-val') || '0', 10);
          elements.timeAgoSlider.value = timeVal.toString();
          elements.timeAgoSlider.dispatchEvent(new Event('input'));
          
          // Toggle active styling
          timePills.forEach(p => {
            p.className = 'time-quick-btn px-2 py-0.5 text-[10px] font-medium rounded-xs border border-hairline bg-canvas text-body hover:text-ink transition-vercel focus:outline-none cursor-pointer';
          });
          pill.className = 'time-quick-btn px-2 py-0.5 text-[10px] font-semibold rounded-xs border border-transparent bg-primary text-canvas-soft shadow-vercel-1 transition-vercel focus:outline-none cursor-pointer';
        });
      });

      // Maintain time pill active state when slider changes manually
      elements.timeAgoSlider.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        const currentMins = parseInt(target.value, 10);
        
        timePills.forEach(pill => {
          const pillVal = parseInt(pill.getAttribute('data-time-val') || '0', 10);
          if (pillVal === currentMins) {
            pill.className = 'time-quick-btn px-2 py-0.5 text-[10px] font-semibold rounded-xs border border-transparent bg-primary text-canvas-soft shadow-vercel-1 transition-vercel focus:outline-none cursor-pointer';
          } else {
            pill.className = 'time-quick-btn px-2 py-0.5 text-[10px] font-medium rounded-xs border border-hairline bg-canvas text-body hover:text-ink transition-vercel focus:outline-none cursor-pointer';
          }
        });
        
        updateImpactPreview();
      });

      // 4. Advanced Fine-Tuning Block Accordion Toggle
      const advToggle = document.getElementById('advanced-toggle');
      const advFields = document.getElementById('advanced-form-fields');
      const advIcon = document.getElementById('advanced-toggle-icon');
      if (advToggle && advFields && advIcon) {
        advToggle.addEventListener('click', () => {
          const isHidden = advFields.classList.contains('hidden');
          if (isHidden) {
            advFields.classList.remove('hidden');
            advIcon.style.transform = 'rotate(0deg)';
            advToggle.setAttribute('aria-expanded', 'true');
          } else {
            advFields.classList.add('hidden');
            advIcon.style.transform = 'rotate(-90deg)';
            advToggle.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Initial Category trigger to populate Beer sub-presets
      updateDrinkInputsToPresetDefaults('beer');
      renderSubPresets('beer');
      syncActivePills();
      updateImpactPreview();
    }

    // Get biological values normalized to standard units (kg, cm)
    function getNormalizedBiology() {
      let weightKg = userState.weight;
      if (userState.weightUnit === 'lbs') {
        weightKg = weightKg * 0.45359237;
      }
      let heightCm = userState.height;
      if (userState.heightUnit === 'in') {
        heightCm = heightCm * 2.54;
      }
      return {
        gender: userState.gender,
        age: userState.age,
        weightKg,
        heightCm
      };
    }

    // ─── Dynamic Stacked Toast Notification System ───
    function updateToastStack() {
      const toasts = Array.from(elements.toastContainer.children) as HTMLElement[];
      const reversed = [...toasts].reverse(); // newest is index 0
      
      reversed.forEach((toast, idx) => {
        if (idx === 0) {
          // Newest toast (fully visible on top)
          toast.style.transform = 'translateY(0px) scale(1)';
          toast.style.opacity = '1';
          toast.style.zIndex = '100';
        } else if (idx === 1) {
          // Second toast (shifted down and slightly scaled down)
          toast.style.transform = 'translateY(10px) scale(0.95)';
          toast.style.opacity = '0.9';
          toast.style.zIndex = '90';
        } else if (idx === 2) {
          // Third toast (shifted further down and scaled down)
          toast.style.transform = 'translateY(20px) scale(0.90)';
          toast.style.opacity = '0.6';
          toast.style.zIndex = '80';
        } else {
          // Older toasts fade out and are deleted
          toast.style.transform = 'translateY(30px) scale(0.85)';
          toast.style.opacity = '0';
          toast.style.zIndex = '70';
          setTimeout(() => {
            if (toast.parentNode === elements.toastContainer) {
              toast.remove();
            }
          }, 400);
        }
      });
    }

    function showToast(message: string) {
      const toast = document.createElement('div');
      // Position absolute inside top-center container. Start slightly raised and transparent
      toast.className = "absolute top-0 left-0 right-0 bg-canvas text-primary shadow-vercel-4 border border-hairline rounded-md py-3 px-4 flex items-center justify-between gap-3 text-sm font-sans select-none pointer-events-auto opacity-0";
      toast.style.transform = "translateY(-15px) scale(0.9)";
      toast.style.transition = "transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), z-index 0.4s ease";
      
      toast.innerHTML = `
        <div class="flex items-center gap-2 min-w-0">
          <svg class="h-4.5 w-4.5 text-success shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="font-medium truncate max-w-[220px]">${message}</span>
        </div>
        <button type="button" class="text-mute hover:text-ink focus:outline-none p-1 rounded-sm shrink-0" aria-label="Close Notification">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      `;

      const closeBtn = toast.querySelector('button');
      if (closeBtn) {
        closeBtn.addEventListener('click', dismiss);
      }

      elements.toastContainer.appendChild(toast);

      // Force reflow and animate stack
      requestAnimationFrame(() => {
        updateToastStack();
      });

      const timeoutId = setTimeout(dismiss, 3500);

      function dismiss() {
        clearTimeout(timeoutId);
        // Animate exit upwards and fade out
        toast.style.transform = 'translateY(-20px) scale(0.9)';
        toast.style.opacity = '0';
        
        setTimeout(() => {
          if (toast.parentNode === elements.toastContainer) {
            toast.remove();
            updateToastStack();
          }
        }, 400);
      }
    }



    // ─── Mathematical Estimator Calculations ───
    
    function calculateTBW(gender: string, weightKg: number, heightCm: number, ageYears: number): number {
      if (gender === 'male') {
        return 2.447 - (0.09516 * ageYears) + (0.1074 * heightCm) + (0.3362 * weightKg);
      } else if (gender === 'female') {
        return -2.097 + (0.1069 * heightCm) + (0.2466 * weightKg);
      } else {
        const male = 2.447 - (0.09516 * ageYears) + (0.1074 * heightCm) + (0.3362 * weightKg);
        const female = -2.097 + (0.1069 * heightCm) + (0.2466 * weightKg);
        return (male + female) / 2;
      }
    }

    function formatTimeLabel(relativeHours: number): string {
      const now = new Date();
      now.setSeconds(0);
      now.setMilliseconds(0);
      
      const targetTime = new Date(now.getTime() + (relativeHours * 60 * 60 * 1000));
      let h = targetTime.getHours();
      let m: number | string = targetTime.getMinutes();
      const ampm = h >= 12 ? 'PM' : 'AM';
      h = h % 12;
      h = h ? h : 12;
      m = m < 10 ? '0' + m : m;
      return `${h}:${m} ${ampm}`;
    }

    function calculateBACAt(H: number, drinksList: LoggedDrink[], tbwLiters: number): number {
      if (drinksList.length === 0) return 0;
      
      let totalBAC = 0;
      const beta = 0.015;
      const absorptionTime = 0.75;
      
      drinksList.forEach(drink => {
        const consumptionHour = - (drink.timeAgo / 60);
        const elapsedHours = H - consumptionHour;
        
        if (elapsedHours < 0) return;

        const pureAlcoholGrams = drink.vol * (drink.abv / 100) * 0.789;
        const peakBACContribution = (pureAlcoholGrams * 0.8) / (tbwLiters * 10);
        const absorptionFraction = Math.min(1, elapsedHours / absorptionTime);
        const contribution = (absorptionFraction * peakBACContribution) - (beta * elapsedHours);
        
        if (contribution > 0) {
          totalBAC += contribution;
        }
      });
      
      return totalBAC;
    }

    // ─── Drink Adder Form Action ───
    function addDrinkFromForm() {
      const name = elements.drinkName.value.trim() || `Drink #${drinkCount}`;
      let vol = parseFloat(elements.drinkVolume.value);
      const abv = parseFloat(elements.abvInput.value);
      const timeAgo = parseInt(elements.timeAgoSlider.value, 10);
      
      if (isNaN(vol) || vol <= 0) return;
      if (isNaN(abv) || abv <= 0) return;
      
      if (elements.drinkVolumeUnit.textContent === 'oz') {
        vol = vol * 29.5735;
      }
      
      const newDrink = {
        id: 'drink-' + Date.now() + '-' + Math.floor(Math.random() * 1000),
        name,
        vol,
        abv,
        timeAgo,
        addedAt: Date.now() - (timeAgo * 60 * 1000)
      };
      
      lastAddedDrinkId = newDrink.id;
      loggedDrinks.push(newDrink);
      drinkCount++;
      
      // Toast notification trigger (But do NOT update visual result directly on page yet)
      showToast(`${name} added to timeline.`);
      
      // Keep the time slider on the last recorded time value instead of resetting to "0" / "Just now"
      
      // Update logged list display
      renderTimeline();
 
      // If results were unlocked previously, update the live dashboard in real-time or re-lock if timeline is cleared
      if (resultsUnlocked) {
        if (loggedDrinks.length === 0) {
          resultsUnlocked = false;
          elements.resultsLockOverlay.classList.remove('opacity-0', 'pointer-events-none', 'hidden');
          elements.resultsLockOverlay.style.opacity = "";
          elements.resultsLockOverlay.style.transform = "";
          elements.resultsDashboardContent.className = "flex flex-col flex-grow gap-6 opacity-30 pointer-events-none transition-vercel select-none";
        } else {
          recalculateAndUpdateDashboard();
        }
      }
    }

    function removeDrink(id: string, name: string): void {
      loggedDrinks = loggedDrinks.filter(d => d.id !== id);
      renderTimeline();
      showToast(`${name} removed from log.`);
      
      if (resultsUnlocked) {
        if (loggedDrinks.length === 0) {
          resultsUnlocked = false;
          elements.resultsLockOverlay.classList.remove('opacity-0', 'pointer-events-none', 'hidden');
          elements.resultsLockOverlay.style.opacity = "";
          elements.resultsLockOverlay.style.transform = "";
          elements.resultsDashboardContent.className = "flex flex-col flex-grow gap-6 opacity-30 pointer-events-none transition-vercel select-none";
          
          // Reset dynamic readouts and SVG chart paths to sober baselines
          const country = COUNTRIES.find(c => c.code === userState.countryCode);
          const limit = country ? country.limit : 0.05;
          const countryName = country ? country.name : "United States";
          
          updateUIContainer('out-', 0, 0, limit, null, null, 0, [], 0, countryName, false);
          updateUIContainer('modal-', 0, 0, limit, null, null, 0, [], 0, countryName, false);
          
          // Auto navigate to step 2 on mobile if timeline becomes empty
          setStepSelection(2);
        } else {
          recalculateAndUpdateDashboard();
        }
      }
    }

    // ─── Real-time Recalculation & Update (No Re-locking) ───
    function recalculateAndUpdateDashboard() {
      if (loggedDrinks.length === 0) return;
      
      const bio = getNormalizedBiology();
      const tbw = calculateTBW(bio.gender, bio.weightKg, bio.heightCm, bio.age);
      
      const nowMs = Date.now();
      loggedDrinks.forEach(drink => {
        const elapsedMins = Math.round((nowMs - drink.addedAt) / 60000);
        drink.timeAgo = Math.max(0, elapsedMins);
      });

      let earliestDrinkAgo = 0;
      loggedDrinks.forEach(d => {
        if (d.timeAgo > earliestDrinkAgo) earliestDrinkAgo = d.timeAgo;
      });
      const startHour = -(earliestDrinkAgo / 60) - 0.5;
      
      let peakBAC = 0;
      let peakHour = 0;
      let currentBAC = calculateBACAt(0, loggedDrinks, tbw);
      let soberHour: number | null = null;
      let safeHour: number | null = null;
      
      const country = COUNTRIES.find(c => c.code === userState.countryCode);
      if (!country) return;
      const limit = country.limit;

      const scanPoints: { h: number; val: number }[] = [];
      const scanStep = 0.05;
      const endScan = 16.0;
      
      for (let h = startHour; h <= endScan; h += scanStep) {
        const val = calculateBACAt(h, loggedDrinks, tbw);
        scanPoints.push({ h, val });
        
        if (val > peakBAC) {
          peakBAC = val;
          peakHour = h;
        }
        
        if (h >= 0) {
          if (soberHour === null && val <= 0.0001) {
            soberHour = h;
          }
          if (safeHour === null && val < limit) {
            safeHour = h;
          }
        }
      }

      // Render Results inside the main Dashboard container (unlocked)
      updateUIContainer('out-', currentBAC, peakBAC, limit, soberHour, safeHour, peakHour, scanPoints, startHour, country.name, false);
      
      if (elements.resultsModal && !elements.resultsModal.classList.contains('hidden')) {
        updateUIContainer('modal-', currentBAC, peakBAC, limit, soberHour, safeHour, peakHour, scanPoints, startHour, country.name, false);
      }
    }


    function closeModal() {
      // Smooth animated exit for modal overlay and card
      Promise.all([
        (animate as any)(elements.resultsModal, { opacity: 0 }, { duration: 0.2 }),
        (animate as any)(elements.modalCard, { scale: 0.95, y: 15, opacity: 0 }, { duration: 0.2 })
      ]).then(() => {
        elements.resultsModal.classList.remove('flex');
        elements.resultsModal.classList.add('hidden');
        document.body.style.overflow = ''; // Restore scrolling
        
        elements.modalCard.classList.add('scale-95', 'opacity-0');
 
        // Unlock Step 3 (Results) on the main page
        resultsUnlocked = true;
        
        // Fade out overlay and fade in dashboard content
        (animate as any)(elements.resultsLockOverlay, { opacity: 0, scale: 0.95 }, { duration: 0.3 }).then(() => {
          elements.resultsLockOverlay.classList.add('pointer-events-none', 'hidden');
